---
import Base from "../layouts/Base.astro";
---
<Base title="Privacy Policy | MeshCalculator">
  <section class="max-w-3xl mx-auto px-4 py-12 prose">
    <h1 class="text-3xl font-extrabold text-steel-900">Privacy Policy</h1>
    <p class="text-sm text-steel-500">Last updated: September 2026</p>
    <h2 class="text-xl font-bold text-steel-900">What we collect</h2>
    <p>Inquiry form submissions: your email, country, product type and specification. We use this only to forward your inquiry to matching factories.</p>
    <h2 class="text-xl font-bold text-steel-900">What we don't do</h2>
    <ul>
      <li>We don't sell or share buyer data with anyone other than the factories matched to your inquiry.</li>
      <li>We don't run third-party ad trackers.</li>
      <li>We use privacy-friendly, cookieless analytics to count visits.</li>
    </ul>
    <h2 class="text-xl font-bold text-steel-900">Your rights</h2>
    <p>Email us anytime to view or delete your inquiry data: privacy@meshcalculator.com</p>
  </section>
</Base>
