---
import Base from "../../../layouts/Base.astro";

const awgTable: [number, number][] = [
  [6, 4.115], [8, 3.264], [10, 2.588], [12, 2.053], [14, 1.628],
  [16, 1.291], [18, 1.024], [20, 0.812], [22, 0.644], [24, 0.511],
  [26, 0.405], [28, 0.321], [30, 0.255]
];

const swgTable: [number, number][] = [
  [6, 4.877], [8, 4.064], [10, 3.251], [12, 2.642], [14, 2.032],
  [16, 1.626], [18, 1.219], [20, 0.914], [22, 0.711], [24, 0.559],
  [26, 0.457], [28, 0.376], [30, 0.315]
];
---

<Base title="线规换算 — AWG/SWG 转毫米/英寸" description="线规（AWG、SWG）与毫米、英寸互算。丝网和围栏规格换算免费工具。" lang="zh">
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-2xl font-extrabold text-theme-primary">线规换算（AWG / SWG ↔ 毫米）</h1>
    <p class="mt-2 text-theme-secondary">
      在美标线规（AWG）、英标线规（SWG）与公制直径（毫米 / 英寸）之间换算。
      对比美国、英国及中国供应商的丝网规格时必备。
    </p>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <!-- Gauge to mm -->
      <div class="bg-theme-card border border-theme rounded-xl p-6">
        <h2 class="text-lg font-bold text-theme-primary">线规 → 直径</h2>
        <div class="mt-4 space-y-3">
          <div>
            <label class="block text-sm text-theme-secondary mb-1" for="gaugeSystem">线规体系</label>
            <select id="gaugeSystem" class="w-full bg-theme border border-theme rounded px-3 py-2 text-theme-primary">
              <option value="awg">AWG（美标）</option>
              <option value="swg">SWG（英标）</option>
            </select>
          </div>
          <div>
            <label class="block text-sm text-theme-secondary mb-1" for="gaugeNum">线规号</label>
            <input id="gaugeNum" type="number" min="1" max="40" value="16" class="w-full bg-theme border border-theme rounded px-3 py-2 text-theme-primary" />
          </div>
          <div class="grid grid-cols-2 gap-3 pt-2">
            <div class="bg-theme rounded-lg p-3 text-center">
              <div class="text-xs text-theme-muted">直径（毫米）</div>
              <div id="outMm" class="text-xl font-bold text-theme-accent">—</div>
            </div>
            <div class="bg-theme rounded-lg p-3 text-center">
              <div class="text-xs text-theme-muted">直径（英寸）</div>
              <div id="outInch" class="text-xl font-bold text-theme-accent">—</div>
            </div>
          </div>
          <p id="gaugeNote" class="text-xs text-theme-muted"></p>
        </div>
      </div>

      <!-- mm to gauge -->
      <div class="bg-theme-card border border-theme rounded-xl p-6">
        <h2 class="text-lg font-bold text-theme-primary">直径 → 最近线规</h2>
        <div class="mt-4 space-y-3">
          <div>
            <label class="block text-sm text-theme-secondary mb-1" for="mmInput">直径（毫米）</label>
            <input id="mmInput" type="number" step="0.001" value="1.626" class="w-full bg-theme border border-theme rounded px-3 py-2 text-theme-primary" />
          </div>
          <div class="grid grid-cols-2 gap-3 pt-2">
            <div class="bg-theme rounded-lg p-3 text-center">
              <div class="text-xs text-theme-muted">最近 AWG</div>
              <div id="outAwg" class="text-xl font-bold text-theme-accent">—</div>
            </div>
            <div class="bg-theme rounded-lg p-3 text-center">
              <div class="text-xs text-theme-muted">最近 SWG</div>
              <div id="outSwg" class="text-xl font-bold text-theme-accent">—</div>
            </div>
          </div>
          <button id="copyBtn" class="mt-2 accent-bg text-white font-semibold px-4 py-2 rounded-lg w-full">复制结果</button>
          <p id="copyMsg" class="text-xs text-theme-muted text-center"></p>
        </div>
      </div>
    </div>

    <!-- AWG table -->
    <h2 class="mt-12 text-xl font-bold text-theme-primary">AWG 转毫米对照表</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full text-sm border border-theme">
        <thead>
          <tr class="bg-theme-card text-theme-primary">
            <th class="border border-theme px-3 py-2 text-left">AWG</th>
            <th class="border border-theme px-3 py-2 text-left">直径（毫米）</th>
            <th class="border border-theme px-3 py-2 text-left">直径（英寸）</th>
          </tr>
        </thead>
        <tbody>
          {awgTable.map(([g, mm]) => (
            <tr class="odd:bg-theme even:bg-theme-card">
              <td class="border border-theme px-3 py-1.5 text-theme-primary">{g}</td>
              <td class="border border-theme px-3 py-1.5 text-theme-secondary">{mm.toFixed(3)}</td>
              <td class="border border-theme px-3 py-1.5 text-theme-secondary">{(mm / 25.4).toFixed(4)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- SWG table -->
    <h2 class="mt-10 text-xl font-bold text-theme-primary">SWG 转毫米对照表</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full text-sm border border-theme">
        <thead>
          <tr class="bg-theme-card text-theme-primary">
            <th class="border border-theme px-3 py-2 text-left">SWG</th>
            <th class="border border-theme px-3 py-2 text-left">直径（毫米）</th>
            <th class="border border-theme px-3 py-2 text-left">直径（英寸）</th>
          </tr>
        </thead>
        <tbody>
          {swgTable.map(([g, mm]) => (
            <tr class="odd:bg-theme even:bg-theme-card">
              <td class="border border-theme px-3 py-1.5 text-theme-primary">{g}</td>
              <td class="border border-theme px-3 py-1.5 text-theme-secondary">{mm.toFixed(3)}</td>
              <td class="border border-theme px-3 py-1.5 text-theme-secondary">{(mm / 25.4).toFixed(4)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- FAQ -->
    <h2 class="mt-12 text-xl font-bold text-theme-primary">常见问题</h2>
    <div class="mt-4 space-y-3">
      <details class="bg-theme-card border border-theme rounded-lg p-4">
        <summary class="font-semibold text-theme-primary cursor-pointer">中国丝网工厂用哪种线规体系？</summary>
        <p class="mt-2 text-sm text-theme-secondary">大多数中国工厂直接用毫米报价（如“丝径 1.2 mm”），这是最不容易出错的方式。若按线规报价，通常是 SWG 或 BWG。下单前务必以书面形式确认实际毫米直径。</p>
      </details>
      <details class="bg-theme-card border border-theme rounded-lg p-4">
        <summary class="font-semibold text-theme-primary cursor-pointer">AWG 和 SWG 一样吗？</summary>
        <p class="mt-2 text-sm text-theme-secondary">不一样。同一号线规在两种体系下直径不同——例如 16 SWG 是 1.626 mm，而 16 AWG 只有 1.291 mm。只写“16 号线”而不注明体系的报价是不完整的。</p>
      </details>
      <details class="bg-theme-card border border-theme rounded-lg p-4">
        <summary class="font-semibold text-theme-primary cursor-pointer">为什么同样目数的网，不同厂家重量不一样？</summary>
        <p class="mt-2 text-sm text-theme-secondary">主要原因是丝径公差。“1 mm”的丝实际可能是 0.9–0.95 mm。可用我们的<a href="/zh/tools/welded-wire-mesh-weight-calculator/" class="text-theme-accent hover:underline">重量计算器</a>核算理论重量，并称重样品验证。</p>
      </details>
    </div>

    <!-- Related links -->
    <div class="mt-12 grid gap-4 md:grid-cols-3">
      <a href="/zh/tools/mesh-count-conversion/" class="block p-4 border border-theme rounded hover:border-theme-accent transition">
        <h3 class="font-semibold text-theme-primary mb-1">目数-微米换算器</h3>
        <p class="text-sm text-theme-secondary">目数换算微米孔径</p>
      </a>
      <a href="/zh/charts/mesh-size-chart/" class="block p-4 border border-theme rounded hover:border-theme-accent transition">
        <h3 class="font-semibold text-theme-primary mb-1">目数尺寸对照表</h3>
        <p class="text-sm text-theme-secondary">目数、微米、英寸对照</p>
      </a>
      <a href="/zh/tools/woven-wire-mesh-weight-calculator/" class="block p-4 border border-theme rounded hover:border-theme-accent transition">
        <h3 class="font-semibold text-theme-primary mb-1">网重计算器</h3>
        <p class="text-sm text-theme-secondary">每平方米 / 每卷理论重量</p>
      </a>
    </div>
  </section>

  <script is:inline>
    const awgData = {6:4.115,8:3.264,10:2.588,12:2.053,14:1.628,16:1.291,18:1.024,20:0.812,22:0.644,24:0.511,26:0.405,28:0.321,30:0.255,32:0.202,34:0.160,36:0.127};
    const swgData = {6:4.877,8:4.064,10:3.251,12:2.642,14:2.032,16:1.626,18:1.219,20:0.914,22:0.711,24:0.559,26:0.457,28:0.376,30:0.315,32:0.274,34:0.234,36:0.193};

    function nearest(data, mm) {
      let best = null, bestDiff = Infinity;
      for (const g in data) {
        const d = Math.abs(data[g] - mm);
        if (d < bestDiff) { bestDiff = d; best = +g; }
      }
      return best;
    }

    function calcGauge() {
      const sys = document.getElementById('gaugeSystem').value;
      const g = parseInt(document.getElementById('gaugeNum').value, 10);
      const data = sys === 'awg' ? awgData : swgData;
      const outMm = document.getElementById('outMm');
      const outInch = document.getElementById('outInch');
      const note = document.getElementById('gaugeNote');
      if (data[g]) {
        outMm.textContent = data[g].toFixed(3) + ' mm';
        outInch.textContent = (data[g] / 25.4).toFixed(4) + '"';
        note.textContent = (sys === 'awg' ? 'AWG' : 'SWG') + ' ' + g + ' = ' + data[g].toFixed(3) + ' mm';
      } else {
        outMm.textContent = '—'; outInch.textContent = '—';
        note.textContent = '线规号超出表格范围（6–36）。';
      }
    }

    function calcMm() {
      const mm = parseFloat(document.getElementById('mmInput').value);
      const outA = document.getElementById('outAwg');
      const outS = document.getElementById('outSwg');
      if (!isNaN(mm) && mm > 0) {
        const a = nearest(awgData, mm), s = nearest(swgData, mm);
        outA.textContent = 'AWG ' + a + ' (' + awgData[a].toFixed(3) + ' mm)';
        outS.textContent = 'SWG ' + s + ' (' + swgData[s].toFixed(3) + ' mm)';
      } else {
        outA.textContent = '—'; outS.textContent = '—';
      }
    }

    document.getElementById('gaugeSystem').addEventListener('change', calcGauge);
    document.getElementById('gaugeNum').addEventListener('input', calcGauge);
    document.getElementById('mmInput').addEventListener('input', calcMm);
    calcGauge(); calcMm();

    document.getElementById('copyBtn').addEventListener('click', function () {
      const text = document.getElementById('mmInput').value + ' mm ≈ ' + document.getElementById('outAwg').textContent + ' / ' + document.getElementById('outSwg').textContent;
      navigator.clipboard.writeText(text).then(function () {
        document.getElementById('copyMsg').textContent = '已复制到剪贴板。';
        setTimeout(function () { document.getElementById('copyMsg').textContent = ''; }, 2000);
      });
    });
  </script>
</Base>
