---
import Base from "../layouts/Base.astro";

const tools = [
  {
    href: "/tools/woven-wire-mesh-weight-calculator/",
    title: "Woven Wire Mesh Weight Calculator",
    desc: "Plain & twill weave SS/steel mesh. Get kg/m² instantly from mesh count and wire diameter.",
    icon: "M4 4h16v16H4z M4 9h16 M4 14h16 M9 4v16 M14 4v16",
    tag: "Most Popular"
  },
  {
    href: "/tools/welded-wire-mesh-weight-calculator/",
    title: "Welded Wire Mesh Weight Calculator",
    desc: "Welded panels & rolls. Calculate weight by opening size, wire diameter and sheet dimensions.",
    icon: "M4 4h16v16H4z M4 12h16 M12 4v16",
    tag: "For Panels"
  },
  {
    href: "/tools/mesh-count-conversion/",
    title: "Mesh ↔ Micron Conversion",
    desc: "Convert mesh count to micron, mm and inch. Includes ASTM E11 sieve table.",
    icon: "M8 4h8 M8 8h8 M8 12h8 M8 16h8",
    tag: "Quick Reference"
  },
];

const products = [
  { href: "/products/stainless-steel-wire-mesh/", title: "Stainless Steel Wire Mesh", desc: "304/316 grades, mesh 1–635, MTC verification" },
  { href: "/products/welded-wire-mesh/", title: "Welded Wire Mesh", desc: "Rolls & panels, galvanizing options, zinc coating specs" },
  { href: "/products/wire-mesh-fence-panels/", title: "Fence Panels", desc: "3D fence systems, posts, coatings, container loading" },
  { href: "/products/gabion-baskets/", title: "Gabion Baskets", desc: "Welded vs woven, Galfan, stone fill guidance" },
];

const applications = [
  { href: "/applications/filtration/", title: "Filtration", desc: "Micron ratings, weave types, alloy selection" },
  { href: "/applications/concrete/", title: "Concrete", desc: "WWR styles, sheets vs rolls, ASTM standards" },
  { href: "/applications/fence/", title: "Fence Systems", desc: "Fence types, height selection, coatings" },
  { href: "/applications/mining/", title: "Mining", desc: "Screen types, 65Mn steel, wear factors" },
  { href: "/applications/agriculture/", title: "Agriculture", desc: "Livestock fencing, crop protection" },
  { href: "/applications/construction/", title: "Construction", desc: "Plaster mesh, masonry reinforcement" },
  { href: "/applications/food-processing/", title: "Food Processing", desc: "Hygienic design, FDA/EU compliance" },
];

const faqs = [
  ["Are the calculators free?", "Yes, all tools are free with no signup. Calculations are theoretical estimates for plain weave / standard welded mesh — always confirm with your factory."],
  ["What is the typical MOQ from Anping factories?", "Usually 1 roll or one panel batch for stock specs; custom specs typically start around 100–500 m² depending on the factory."],
  ["Do factories ship overseas?", "Yes. Anping factories routinely export by sea (FCL/LCL) and have experience with documentation for most markets."],
  ["How do I verify a factory?", "Ask for business license, factory photos/video call, and third-party inspection (SGS/BV/TÜV) before paying. We list factories but do not certify them."],
  ["Do you handle transactions?", "No. We only connect buyers and factories. Negotiation, contracts, payment and quality control are between you and the factory."],
];
---
<Base title="MeshCalculator — Free Wire Mesh Tools & Anping Factory Sourcing" description="Calculate wire mesh weight and specs in seconds. Source direct from real factories in Anping, China's wire mesh capital.">

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-ink-900 via-ink-950 to-ink-950"></div>
    <div class="absolute inset-0 opacity-30" style="background-image: linear-gradient(rgba(251,191,36,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(251,191,36,0.03) 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="relative max-w-6xl mx-auto px-4 py-20 md:py-32 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-amber-500/20 bg-amber-500/5 text-amber-400 text-xs font-mono uppercase tracking-wider mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        Free Tools · No Signup · Direct Factory Access
      </div>
      <h1 class="text-4xl md:text-6xl font-semibold tracking-tight text-white leading-[1.1]">
        Calculate Wire Mesh Specs.<br />
        <span class="text-amber-400">Source Direct</span> from Anping Factories.
      </h1>
      <p class="mt-6 text-lg text-ink-400 max-w-2xl mx-auto leading-relaxed">
        Free weight calculators, spec charts, and a directory of real factories in China's wire mesh capital. No signup. No paid rankings. No trading companies.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/tools/woven-wire-mesh-weight-calculator/" class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-400 text-ink-950 font-semibold px-7 py-3.5 rounded-lg transition-all hover:shadow-[0_0_30px_rgba(251,191,36,0.3)]">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
          Try the Calculator
        </a>
        <a href="/factories/" class="inline-flex items-center gap-2 border border-ink-600 hover:border-amber-400/50 text-ink-200 hover:text-white px-7 py-3.5 rounded-lg transition-all">
          Browse Factories
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
      <div class="mt-16 flex flex-wrap justify-center gap-8 md:gap-16">
        <div class="text-center">
          <p class="text-3xl font-bold text-white">3</p>
          <p class="text-sm text-ink-500 mt-1">Free Tools</p>
        </div>
        <div class="text-center">
          <p class="text-3xl font-bold text-white">20,000+</p>
          <p class="text-sm text-ink-500 mt-1">Anping Factories</p>
        </div>
        <div class="text-center">
          <p class="text-3xl font-bold text-white">100%</p>
          <p class="text-sm text-ink-500 mt-1">Free Access</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tools -->
  <section class="relative py-20">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-center gap-3 mb-10">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-ink-700 to-transparent"></div>
        <span class="text-amber-400 font-mono text-xs uppercase tracking-widest">Free Tools</span>
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-ink-700 to-transparent"></div>
      </div>
      <h2 class="text-3xl font-semibold text-white text-center mb-12">Professional Calculators</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {tools.map((t) => (
          <a href={t.href} class="card card-accent relative group">
            <div class="flex items-start justify-between mb-4">
              <div class="w-12 h-12 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={t.icon}/></svg>
              </div>
              <span class="text-xs font-mono text-amber-400/70 uppercase tracking-wider">{t.tag}</span>
            </div>
            <h3 class="font-semibold text-lg text-white mb-2 group-hover:text-amber-400 transition-colors">{t.title}</h3>
            <p class="text-sm text-ink-400 leading-relaxed">{t.desc}</p>
            <div class="mt-4 flex items-center gap-1 text-sm text-amber-400/80 group-hover:text-amber-400 transition-colors">
              Open tool
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="relative py-20 bg-ink-900/50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-center gap-3 mb-10">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-ink-700 to-transparent"></div>
        <span class="text-amber-400 font-mono text-xs uppercase tracking-widest">Process</span>
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-ink-700 to-transparent"></div>
      </div>
      <h2 class="text-3xl font-semibold text-white text-center mb-12">How Sourcing Works</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { num: "01", title: "Calculate your specs", desc: "Know exactly what you need — weight, opening, wire diameter — before you ask for a quote." },
          { num: "02", title: "Pick real factories", desc: "Browse our directory of Anping manufacturers. Every listing is a factory, not a reseller." },
          { num: "03", title: "Send one inquiry", desc: "Use our inquiry form — your requirement goes to matching factories directly. No middlemen." },
        ].map((item) => (
          <div class="relative">
            <div class="card h-full">
              <span class="text-5xl font-bold text-ink-800 font-mono">{item.num}</span>
              <h3 class="font-semibold text-lg text-white mt-4 mb-2">{item.title}</h3>
              <p class="text-sm text-ink-400 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Products -->
  <section class="relative py-20">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-center gap-3 mb-10">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-ink-700 to-transparent"></div>
        <span class="text-amber-400 font-mono text-xs uppercase tracking-widest">Products</span>
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-ink-700 to-transparent"></div>
      </div>
      <h2 class="text-3xl font-semibold text-white text-center mb-12">Product Guides</h2>
      <div class="grid md:grid-cols-2 gap-4">
        {products.map((p) => (
          <a href={p.href} class="card card-accent group flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg bg-ink-800 border border-ink-700 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            </div>
            <div class="flex-1">
              <h3 class="font-semibold text-white group-hover:text-amber-400 transition-colors">{p.title}</h3>
              <p class="text-sm text-ink-400 mt-1">{p.desc}</p>
            </div>
            <svg class="w-5 h-5 text-ink-600 group-hover:text-amber-400 group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Applications -->
  <section class="relative py-20 bg-ink-900/50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-center gap-3 mb-10">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-ink-700 to-transparent"></div>
        <span class="text-amber-400 font-mono text-xs uppercase tracking-widest">Applications</span>
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-ink-700 to-transparent"></div>
      </div>
      <h2 class="text-3xl font-semibold text-white text-center mb-12">Application Guides</h2>
      <div class="grid md:grid-cols-3 lg:grid-cols-4 gap-4">
        {applications.map((a) => (
          <a href={a.href} class="card card-accent group">
            <h3 class="font-semibold text-white group-hover:text-amber-400 transition-colors mb-1">{a.title}</h3>
            <p class="text-xs text-ink-400">{a.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Anping -->
  <section class="relative py-20">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <div class="flex items-center gap-3 mb-10">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-ink-700 to-transparent"></div>
        <span class="text-amber-400 font-mono text-xs uppercase tracking-widest">Why Anping</span>
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-ink-700 to-transparent"></div>
      </div>
      <h2 class="text-3xl font-semibold text-white mb-6">The Wire Mesh Capital of China</h2>
      <p class="text-ink-400 leading-relaxed max-w-2xl mx-auto">
        Anping County in Hebei Province produces the majority of China's wire mesh — an estimated <span class="text-white font-medium">80% of national output</span>. Over <span class="text-white font-medium">20,000 factories and workshops</span> cover the full spectrum: stainless steel woven mesh, welded mesh, fence panels, gabion baskets, expanded metal and perforated metal. Decades of clustered supply chains mean competitive pricing, deep technical know-how, and fast sampling.
      </p>
      <a href="/anping-wire-mesh/" class="inline-flex items-center gap-2 mt-6 text-amber-400 hover:text-amber-300 font-medium transition-colors">
        Learn more about Anping
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="relative py-20 bg-ink-900/50">
    <div class="max-w-3xl mx-auto px-4">
      <div class="flex items-center gap-3 mb-10">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-ink-700 to-transparent"></div>
        <span class="text-amber-400 font-mono text-xs uppercase tracking-widest">FAQ</span>
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-ink-700 to-transparent"></div>
      </div>
      <h2 class="text-3xl font-semibold text-white text-center mb-12">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map(([q, a]) => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="font-medium text-white">{q}</span>
              <svg class="w-5 h-5 text-ink-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-3 text-sm text-ink-400 leading-relaxed">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-20">
    <div class="max-w-4xl mx-auto px-4">
      <div class="card card-accent relative overflow-hidden text-center py-16">
        <div class="absolute inset-0 bg-gradient-to-br from-amber-500/5 via-transparent to-transparent"></div>
        <div class="relative">
          <h2 class="text-3xl font-semibold text-white mb-4">Ready to Source Direct?</h2>
          <p class="text-ink-400 max-w-xl mx-auto mb-8">Send your requirement to matching Anping factories. No middlemen, no hidden fees.</p>
          <a href="/inquiry/" class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-400 text-ink-950 font-semibold px-8 py-4 rounded-lg transition-all hover:shadow-[0_0_40px_rgba(251,191,36,0.3)]">
            Send an Inquiry
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
