---
import Base from "../layouts/Base.astro";
import en from "../i18n/en.json";

const t = en;

const tools = [
  {
    href: "/tools/woven-wire-mesh-weight-calculator/",
    title: t.tools.items[0].title,
    desc: t.tools.items[0].desc,
    icon: "M4 4h16v16H4z M4 9h16 M4 14h16 M9 4v16 M14 4v16",
    tag: t.tools.items[0].tag
  },
  {
    href: "/tools/welded-wire-mesh-weight-calculator/",
    title: t.tools.items[1].title,
    desc: t.tools.items[1].desc,
    icon: "M4 4h16v16H4z M4 12h16 M12 4v16",
    tag: t.tools.items[1].tag
  },
  {
    href: "/tools/mesh-count-conversion/",
    title: t.tools.items[2].title,
    desc: t.tools.items[2].desc,
    icon: "M8 4h8 M8 8h8 M8 12h8 M8 16h8",
    tag: t.tools.items[2].tag
  },
  {
    href: "/tools/fob-price-calculator/",
    title: "FOB Price Calculator",
    desc: "Convert RMB factory price to USD/EUR/GBP FOB quotes with live exchange rates.",
    icon: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    tag: "Export Tool"
  },
  {
    href: "/tools/inquiry-template-generator/",
    title: "Inquiry Template Generator",
    desc: "Create professional RFQ emails for wire mesh sourcing. Bilingual EN/ZH output.",
    icon: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
    tag: "Sourcing Tool"
  },
  {
    href: "/tools/container-loading-calculator/",
    title: "Container Loading Calculator",
    desc: "Calculate how much wire mesh fits in 20ft/40ft containers. Optimize export shipments.",
    icon: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4",
    tag: "Shipping Tool"
  },
];

const products = [
  { href: "/products/stainless-steel-wire-mesh/", title: "Stainless Steel Wire Mesh", desc: "304/316 grades, mesh 1–635, MTC verification" },
  { href: "/products/welded-wire-mesh/", title: "Welded Wire Mesh", desc: "Rolls & panels, galvanizing options, zinc coating specs" },
  { href: "/products/wire-mesh-fence-panels/", title: "Fence Panels", desc: "3D fence systems, posts, coatings, container loading" },
  { href: "/products/gabion-baskets/", title: "Gabion Baskets", desc: "Welded vs woven, Galfan, stone fill guidance" },
];

const applications = [
  { href: "/applications/filtration/", title: "Filtration", desc: "Micron ratings, weave types, alloy selection" },
  { href: "/applications/concrete/", title: "Concrete", desc: "WWR styles, sheets vs rolls, ASTM standards" },
  { href: "/applications/fence/", title: "Fence Systems", desc: "Fence types, height selection, coatings" },
  { href: "/applications/mining/", title: "Mining", desc: "Screen types, 65Mn steel, wear factors" },
  { href: "/applications/agriculture/", title: "Agriculture", desc: "Livestock fencing, crop protection" },
  { href: "/applications/construction/", title: "Construction", desc: "Plaster mesh, masonry reinforcement" },
  { href: "/applications/food-processing/", title: "Food Processing", desc: "Hygienic design, FDA/EU compliance" },
];

const faqs = [
  ["Are the calculators free?", "Yes, all tools are free with no signup. Calculations are theoretical estimates for plain weave / standard welded mesh — always confirm with your factory."],
  ["What is the typical MOQ from Anping factories?", "Usually 1 roll or one panel batch for stock specs; custom specs typically start around 100–500 m² depending on the factory."],
  ["Do factories ship overseas?", "Yes. Anping factories routinely export by sea (FCL/LCL) and have experience with documentation for most markets."],
  ["How do I verify a factory?", "Ask for business license, factory photos/video call, and third-party inspection (SGS/BV/TÜV) before paying. We list factories but do not certify them."],
  ["Do you handle transactions?", "No. We only connect buyers and factories. Negotiation, contracts, payment and quality control are between you and the factory."],
];
---
<Base title="MeshCalculator — Free Wire Mesh Tools & Anping Factory Sourcing" description="Calculate wire mesh weight and specs in seconds. Source direct from real factories in Anping, China's wire mesh capital." lang="en">

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-theme-tertiary via-theme-primary to-theme-primary"></div>
    <div class="absolute inset-0 opacity-30" style="background-image: linear-gradient(rgba(245,158,11,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(245,158,11,0.03) 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="relative max-w-6xl mx-auto px-4 py-20 md:py-32 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-theme accent-border accent-text text-xs font-mono uppercase tracking-wider mb-6">
        <span class="w-1.5 h-1.5 rounded-full accent-bg animate-pulse"></span>
        {t.hero.badge}
      </div>
      <h1 class="text-4xl md:text-6xl font-semibold tracking-tight text-theme-primary leading-[1.1]">
        {t.hero.title1}<br />
        <span class="accent-text">{t.hero.title2}</span> {t.hero.title3}
      </h1>
      <p class="mt-6 text-lg text-theme-secondary max-w-2xl mx-auto leading-relaxed">
        {t.hero.subtitle}
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/tools/woven-wire-mesh-weight-calculator/" class="inline-flex items-center gap-2 accent-bg hover:opacity-90 font-semibold px-7 py-3.5 rounded-lg transition-all hover:shadow-[0_0_30px_rgba(245,158,11,0.3)]" style="color: #07090c;">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
          {t.hero.tryCalculator}
        </a>
        <a href="/factories/" class="inline-flex items-center gap-2 border border-theme hover:border-theme-muted text-theme-secondary hover:text-theme-primary px-7 py-3.5 rounded-lg transition-all">
          {t.hero.browseFactories}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
      <div class="mt-16 flex flex-wrap justify-center gap-8 md:gap-16">
        <div class="text-center">
          <p class="text-3xl font-bold text-theme-primary">3</p>
          <p class="text-sm text-theme-muted mt-1">{t.hero.stats.tools}</p>
        </div>
        <div class="text-center">
          <p class="text-3xl font-bold text-theme-primary">20,000+</p>
          <p class="text-sm text-theme-muted mt-1">{t.hero.stats.factories}</p>
        </div>
        <div class="text-center">
          <p class="text-3xl font-bold text-theme-primary">100%</p>
          <p class="text-sm text-theme-muted mt-1">{t.hero.stats.free}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tools -->
  <section class="relative py-20">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-center gap-3 mb-10">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-theme-muted to-transparent"></div>
        <span class="accent-text font-mono text-xs uppercase tracking-widest">{t.tools.badge}</span>
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-theme-muted to-transparent"></div>
      </div>
      <h2 class="text-3xl font-semibold text-theme-primary text-center mb-12">{t.tools.title}</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {tools.map((tool) => (
          <a href={tool.href} class="card card-accent relative group">
            <div class="flex items-start justify-between mb-4">
              <div class="w-12 h-12 rounded-lg accent-bg accent-border border flex items-center justify-center" style="background: var(--accent-light); border-color: var(--accent);">
                <svg class="w-6 h-6 accent-text" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={tool.icon}/></svg>
              </div>
              <span class="text-xs font-mono accent-text uppercase tracking-wider opacity-70">{tool.tag}</span>
            </div>
            <h3 class="font-semibold text-lg text-theme-primary mb-2 group-hover:text-theme-secondary transition-colors">{tool.title}</h3>
            <p class="text-sm text-theme-secondary leading-relaxed">{tool.desc}</p>
            <div class="mt-4 flex items-center gap-1 text-sm accent-text opacity-80 group-hover:opacity-100 transition-opacity">
              {t.tools.items[0].open}
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="relative py-20 bg-theme-secondary">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-center gap-3 mb-10">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-theme-muted to-transparent"></div>
        <span class="accent-text font-mono text-xs uppercase tracking-widest">{t.process.badge}</span>
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-theme-muted to-transparent"></div>
      </div>
      <h2 class="text-3xl font-semibold text-theme-primary text-center mb-12">{t.process.title}</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {t.process.steps.map((step) => (
          <div class="relative">
            <div class="card h-full">
              <span class="text-5xl font-bold text-theme-muted font-mono opacity-30">{step.num}</span>
              <h3 class="font-semibold text-lg text-theme-primary mt-4 mb-2">{step.title}</h3>
              <p class="text-sm text-theme-secondary leading-relaxed">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Products -->
  <section class="relative py-20">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-center gap-3 mb-10">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-theme-muted to-transparent"></div>
        <span class="accent-text font-mono text-xs uppercase tracking-widest">{t.products.badge}</span>
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-theme-muted to-transparent"></div>
      </div>
      <h2 class="text-3xl font-semibold text-theme-primary text-center mb-12">{t.products.title}</h2>
      <div class="grid md:grid-cols-2 gap-4">
        {products.map((p) => (
          <a href={p.href} class="card card-accent group flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg bg-theme-tertiary border border-theme flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 accent-text" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            </div>
            <div class="flex-1">
              <h3 class="font-semibold text-theme-primary group-hover:text-theme-secondary transition-colors">{p.title}</h3>
              <p class="text-sm text-theme-secondary mt-1">{p.desc}</p>
            </div>
            <svg class="w-5 h-5 text-theme-muted group-hover:accent-text group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Applications -->
  <section class="relative py-20 bg-theme-secondary">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-center gap-3 mb-10">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-theme-muted to-transparent"></div>
        <span class="accent-text font-mono text-xs uppercase tracking-widest">{t.applications.badge}</span>
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-theme-muted to-transparent"></div>
      </div>
      <h2 class="text-3xl font-semibold text-theme-primary text-center mb-12">{t.applications.title}</h2>
      <div class="grid md:grid-cols-3 lg:grid-cols-4 gap-4">
        {applications.map((a) => (
          <a href={a.href} class="card card-accent group">
            <h3 class="font-semibold text-theme-primary group-hover:text-theme-secondary transition-colors mb-1">{a.title}</h3>
            <p class="text-xs text-theme-secondary">{a.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Anping -->
  <section class="relative py-20">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <div class="flex items-center gap-3 mb-10">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-theme-muted to-transparent"></div>
        <span class="accent-text font-mono text-xs uppercase tracking-widest">{t.whyAnping.badge}</span>
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-theme-muted to-transparent"></div>
      </div>
      <h2 class="text-3xl font-semibold text-theme-primary mb-6">{t.whyAnping.title}</h2>
      <p class="text-theme-secondary leading-relaxed max-w-2xl mx-auto">
        {t.whyAnping.desc}
      </p>
      <a href="/anping-wire-mesh/" class="inline-flex items-center gap-2 mt-6 accent-text hover:opacity-80 font-medium transition-opacity">
        {t.whyAnping.learnMore}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>

  <!-- Blog -->
  <section class="relative py-20">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-center gap-3 mb-10">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-theme-muted to-transparent"></div>
        <span class="accent-text font-mono text-xs uppercase tracking-widest">Guides & Insights</span>
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-theme-muted to-transparent"></div>
      </div>
      <h2 class="text-3xl font-semibold text-theme-primary text-center mb-12">Latest from the Blog</h2>
      <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <a href="/blog/how-to-choose-wire-mesh-for-filtration/" class="card card-accent group">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-mono accent-text uppercase tracking-wider">Buyer Guide</span>
            <span class="text-xs text-theme-muted">• 7 min read</span>
          </div>
          <h3 class="font-semibold text-lg text-theme-primary mb-2 group-hover:text-theme-secondary transition-colors">How to Choose Wire Mesh for Industrial Filtration</h3>
          <p class="text-sm text-theme-secondary leading-relaxed mb-4">Material selection, mesh sizing, weave types, and procurement tips for filtration applications.</p>
          <div class="flex items-center gap-1 text-sm accent-text opacity-80 group-hover:opacity-100 transition-opacity">
            Read guide
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
        </a>
        <a href="/blog/wire-mesh-size-chart-explained/" class="card card-accent group">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-mono accent-text uppercase tracking-wider">Technical Guide</span>
            <span class="text-xs text-theme-muted">• 8 min read</span>
          </div>
          <h3 class="font-semibold text-lg text-theme-primary mb-2 group-hover:text-theme-secondary transition-colors">Wire Mesh Size Chart Explained</h3>
          <p class="text-sm text-theme-secondary leading-relaxed mb-4">Mesh count vs micron vs wire gauge — complete conversion tables and international standards.</p>
          <div class="flex items-center gap-1 text-sm accent-text opacity-80 group-hover:opacity-100 transition-opacity">
            Read guide
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
        </a>
      </div>
      <div class="text-center mt-8">
        <a href="/blog/" class="inline-flex items-center gap-2 text-sm text-theme-secondary hover:text-theme-primary transition-colors">
          View all articles
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="relative py-20 bg-theme-secondary">
    <div class="max-w-3xl mx-auto px-4">
      <div class="flex items-center gap-3 mb-10">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-theme-muted to-transparent"></div>
        <span class="accent-text font-mono text-xs uppercase tracking-widest">{t.faq.badge}</span>
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-theme-muted to-transparent"></div>
      </div>
      <h2 class="text-3xl font-semibold text-theme-primary text-center mb-12">{t.faq.title}</h2>
      <div class="space-y-3">
        {faqs.map(([q, a]) => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="font-medium text-theme-primary">{q}</span>
              <svg class="w-5 h-5 text-theme-muted group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-3 text-sm text-theme-secondary leading-relaxed">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-20">
    <div class="max-w-4xl mx-auto px-4">
      <div class="card card-accent relative overflow-hidden text-center py-16">
        <div class="absolute inset-0 bg-gradient-to-br from-theme-tertiary via-transparent to-transparent"></div>
        <div class="relative">
          <h2 class="text-3xl font-semibold text-theme-primary mb-4">{t.cta.title}</h2>
          <p class="text-theme-secondary max-w-xl mx-auto mb-8">{t.cta.desc}</p>
          <a href="/inquiry/" class="inline-flex items-center gap-2 accent-bg hover:opacity-90 font-semibold px-8 py-4 rounded-lg transition-all hover:shadow-[0_0_40px_rgba(245,158,11,0.3)]" style="color: #07090c;">
            {t.cta.button}
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
