            <tr class="bg-theme-card border-b border-theme">
              <th class="text-left p-3 text-theme-primary font-semibold">Parameter</th>
              <th class="text-left p-3 text-theme-primary font-semibold">Standard Factory Tolerance</th>
              <th class="text-left p-3 text-theme-primary font-semibold">Notes</th>
            </tr>
          </thead>
          <tbody class="text-theme-secondary">
            <tr class="border-b border-theme">
              <td class="p-3 font-medium">Panel length / width</td>
              <td class="p-3">±5 mm</td>
              <td class="p-3">Tighten to ±3 mm in contract if panels must align in a system</td>
            </tr>
            <tr class="border-b border-theme">
              <td class="p-3 font-medium">Wire diameter</td>
              <td class="p-3">±5% (ASTM A974)</td>
              <td class="p-3">A 4.0 mm wire can legally arrive at 3.8 mm—weigh rolls to verify</td>
            </tr>
            <tr class="border-b border-theme">
              <td class="p-3 font-medium">Aperture (mesh opening)</td>
              <td class="p-3">±3% of nominal</td>
              <td class="p-3">Count openings across a 1 m gauge length</td>
            </tr>
            <tr class="border-b border-theme">
              <td class="p-3 font-medium">Squareness (corner angle)</td>
              <td class="p-3">≤3 mm diagonal difference</td>
              <td class="p-3">Rarely stated; ask if panels stack in racks</td>
            </tr>
            <tr class="border-b border-theme">
              <td class="p-3 font-medium">Bent edge height (V/U folds)</td>
              <td class="p-3">±3 mm</td>
              <td class="p-3">Folds typically 20–30 mm high on fence panels</td>
            </tr>
            <tr>
              <td class="p-3 font-medium">Roll width</td>
              <td class="p-3">±10 mm</td>
              <td class="p-3">Wider tolerance than panels; critical for machine guards—specify tighter if needed</td>
            </tr>
          </tbody>
        </table>
