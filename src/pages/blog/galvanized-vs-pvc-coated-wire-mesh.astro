              <td class="p-3">$0.60–0.80 / m²</td>
              <td class="p-3">1.8–2.2×</td>
            </tr>
            <tr>
              <td class="p-3 font-medium">PVC-coated (0.7 mm skin on HDG wire)</td>
              <td class="p-3">$0.70–1.10 / m²</td>
              <td class="p-3">2.0–2.8×</td>
            </tr>
          </tbody>
        </table>
