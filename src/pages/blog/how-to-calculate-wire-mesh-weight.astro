      <h3 class="text-xl font-bold text-theme-primary mb-4">Related Resources</h3>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/charts/mesh-size-chart/" class="bg-theme-card border border-theme rounded-lg p-4 hover:border-theme-primary transition block">
