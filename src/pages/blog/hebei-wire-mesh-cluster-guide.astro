            <tr class="bg-theme-card border-b border-theme">
              <th class="text-left p-3 text-theme-primary font-semibold">Effect of Hyper-Competition</th>
              <th class="text-left p-3 text-theme-primary font-semibold">Buyer Benefit</th>
              <th class="text-left p-3 text-theme-primary font-semibold">Hidden Cost</th>
            </tr>
          </thead>
