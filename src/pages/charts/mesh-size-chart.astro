---
import Base from "../../layouts/Base.astro";
---
<Base title="Wire Mesh Size Chart — Mesh Count, Wire Gauge & Opening | MeshCalculator" description="Quick reference chart: mesh count vs wire diameter vs opening size for common stainless steel woven wire mesh specifications.">
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-theme-primary">Wire Mesh Size Chart</h1>
    <p class="mt-2 text-theme-secondary">Common stainless steel woven mesh specifications. Opening = 25.4 ÷ mesh − wire diameter.</p>

    <h2 class="text-xl font-bold text-theme-primary mt-8">Common specs (stainless steel 304/316)</h2>
    <div class="flex flex-wrap gap-2 mt-4 mb-4">
      <button id="exportCsvBtn" class="accent-bg text-sm font-semibold px-4 py-2 rounded-lg hover:opacity-90 transition-opacity" style="color: #07090c;">Export CSV</button>
      <button id="copyTableBtn" class="border border-theme text-sm font-semibold px-4 py-2 rounded-lg hover:border-theme-muted transition-colors text-theme-primary">Copy Table</button>
    </div>
    <div class="overflow-x-auto mt-4">
      <table id="meshTable" class="w-full text-sm border-collapse">
        <thead>
          <tr>
            <th class="text-left px-3 py-2 border border-theme bg-theme-tertiary text-theme-primary font-semibold">Mesh</th>
            <th class="text-left px-3 py-2 border border-theme bg-theme-tertiary text-theme-primary font-semibold">Wire dia (mm)</th>
            <th class="text-left px-3 py-2 border border-theme bg-theme-tertiary text-theme-primary font-semibold">Opening (mm)</th>
            <th class="text-left px-3 py-2 border border-theme bg-theme-tertiary text-theme-primary font-semibold">Typical use</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-theme"><td class="px-3 py-2 border border-theme text-theme-primary">2</td><td class="px-3 py-2 border border-theme text-theme-secondary">1.80</td><td class="px-3 py-2 border border-theme text-theme-secondary">10.90</td><td class="px-3 py-2 border border-theme text-theme-secondary">Heavy screening</td></tr>
          <tr class="border-b border-theme"><td class="px-3 py-2 border border-theme text-theme-primary">4</td><td class="px-3 py-2 border border-theme text-theme-secondary">1.20</td><td class="px-3 py-2 border border-theme text-theme-secondary">5.15</td><td class="px-3 py-2 border border-theme text-theme-secondary">Gravel screens</td></tr>
          <tr class="border-b border-theme"><td class="px-3 py-2 border border-theme text-theme-primary">8</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.70</td><td class="px-3 py-2 border border-theme text-theme-secondary">2.48</td><td class="px-3 py-2 border border-theme text-theme-secondary">Filter support</td></tr>
          <tr class="border-b border-theme"><td class="px-3 py-2 border border-theme text-theme-primary">12</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.50</td><td class="px-3 py-2 border border-theme text-theme-secondary">1.62</td><td class="px-3 py-2 border border-theme text-theme-secondary">Filter mesh</td></tr>
          <tr class="border-b border-theme"><td class="px-3 py-2 border border-theme text-theme-primary">20</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.40</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.87</td><td class="px-3 py-2 border border-theme text-theme-secondary">Water filtration</td></tr>
          <tr class="border-b border-theme"><td class="px-3 py-2 border border-theme text-theme-primary">40</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.25</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.39</td><td class="px-3 py-2 border border-theme text-theme-secondary">Water/oil filtration</td></tr>
          <tr class="border-b border-theme"><td class="px-3 py-2 border border-theme text-theme-primary">60</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.19</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.23</td><td class="px-3 py-2 border border-theme text-theme-secondary">Fine filtration</td></tr>
          <tr class="border-b border-theme"><td class="px-3 py-2 border border-theme text-theme-primary">80</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.14</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.18</td><td class="px-3 py-2 border border-theme text-theme-secondary">Ultra-fine filtration</td></tr>
          <tr class="border-b border-theme"><td class="px-3 py-2 border border-theme text-theme-primary">100</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.10</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.154</td><td class="px-3 py-2 border border-theme text-theme-secondary">Standard filter cloth</td></tr>
          <tr class="border-b border-theme"><td class="px-3 py-2 border border-theme text-theme-primary">150</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.07</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.099</td><td class="px-3 py-2 border border-theme text-theme-secondary">Fine screening</td></tr>
          <tr class="border-b border-theme"><td class="px-3 py-2 border border-theme text-theme-primary">200</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.05</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.077</td><td class="px-3 py-2 border border-theme text-theme-secondary">Pharmaceutical</td></tr>
          <tr class="border-b border-theme"><td class="px-3 py-2 border border-theme text-theme-primary">325</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.035</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.043</td><td class="px-3 py-2 border border-theme text-theme-secondary">Lab / pharma</td></tr>
          <tr class="border-b border-theme"><td class="px-3 py-2 border border-theme text-theme-primary">400</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.030</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.034</td><td class="px-3 py-2 border border-theme text-theme-secondary">Ultra-fine</td></tr>
        </tbody>
      </table>
    </div>

    <h2 class="text-xl font-bold text-theme-primary mt-10">Wire gauge ↔ mm (common mesh wire)</h2>
    <div class="overflow-x-auto mt-4">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr>
            <th class="text-left px-3 py-2 border border-theme bg-theme-tertiary text-theme-primary font-semibold">SWG</th>
            <th class="text-left px-3 py-2 border border-theme bg-theme-tertiary text-theme-primary font-semibold">mm</th>
            <th class="text-left px-3 py-2 border border-theme bg-theme-tertiary text-theme-primary font-semibold">SWG</th>
            <th class="text-left px-3 py-2 border border-theme bg-theme-tertiary text-theme-primary font-semibold">mm</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-theme"><td class="px-3 py-2 border border-theme text-theme-primary">10</td><td class="px-3 py-2 border border-theme text-theme-secondary">3.25</td><td class="px-3 py-2 border border-theme text-theme-primary">26</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.46</td></tr>
          <tr class="border-b border-theme"><td class="px-3 py-2 border border-theme text-theme-primary">12</td><td class="px-3 py-2 border border-theme text-theme-secondary">2.64</td><td class="px-3 py-2 border border-theme text-theme-primary">28</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.38</td></tr>
          <tr class="border-b border-theme"><td class="px-3 py-2 border border-theme text-theme-primary">14</td><td class="px-3 py-2 border border-theme text-theme-secondary">2.03</td><td class="px-3 py-2 border border-theme text-theme-primary">30</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.32</td></tr>
          <tr class="border-b border-theme"><td class="px-3 py-2 border border-theme text-theme-primary">16</td><td class="px-3 py-2 border border-theme text-theme-secondary">1.63</td><td class="px-3 py-2 border border-theme text-theme-primary">32</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.27</td></tr>
          <tr class="border-b border-theme"><td class="px-3 py-2 border border-theme text-theme-primary">18</td><td class="px-3 py-2 border border-theme text-theme-secondary">1.22</td><td class="px-3 py-2 border border-theme text-theme-primary">34</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.23</td></tr>
          <tr class="border-b border-theme"><td class="px-3 py-2 border border-theme text-theme-primary">20</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.91</td><td class="px-3 py-2 border border-theme text-theme-primary">36</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.19</td></tr>
          <tr class="border-b border-theme"><td class="px-3 py-2 border border-theme text-theme-primary">22</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.71</td><td class="px-3 py-2 border border-theme text-theme-primary">38</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.15</td></tr>
          <tr class="border-b border-theme"><td class="px-3 py-2 border border-theme text-theme-primary">24</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.56</td><td class="px-3 py-2 border border-theme text-theme-primary">40</td><td class="px-3 py-2 border border-theme text-theme-secondary">0.12</td></tr>
        </tbody>
      </table>
    </div>
    <p class="text-sm text-theme-muted mt-4">China factories usually quote wire diameter in mm, not gauge. Always specify mm to avoid confusion.</p>

    <div class="mt-10 bg-theme-tertiary border border-theme rounded-xl p-6">
      <p class="font-semibold text-theme-primary">Need an exact weight for your spec?</p>
      <a href="/tools/woven-wire-mesh-weight-calculator/" class="accent-text font-semibold">Use the weight calculator →</a>
    </div>
  </section>

  <script>
    function exportToCsv() {
      const table = document.getElementById("meshTable");
      if (!table) return;
      
      let csv = "Mesh,Wire dia (mm),Opening (mm),Typical use\n";
      const rows = table.querySelectorAll("tbody tr");
      rows.forEach(row => {
        const cells = row.querySelectorAll("td");
        const values = Array.from(cells).map(cell => `"${cell.textContent.trim()}"`);
        csv += values.join(",") + "\n";
      });
      
      const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "wire-mesh-specs.csv";
      a.click();
      URL.revokeObjectURL(url);
    }

    function copyTable() {
      const table = document.getElementById("meshTable");
      if (!table) return;
      
      let text = "Mesh\tWire dia (mm)\tOpening (mm)\tTypical use\n";
      const rows = table.querySelectorAll("tbody tr");
      rows.forEach(row => {
        const cells = row.querySelectorAll("td");
        const values = Array.from(cells).map(cell => cell.textContent.trim());
        text += values.join("\t") + "\n";
      });
      
      navigator.clipboard.writeText(text).then(() => {
        const btn = document.getElementById("copyTableBtn");
        const original = btn.textContent;
        btn.textContent = "Copied!";
        setTimeout(() => { btn.textContent = original; }, 2000);
      });
    }

    document.getElementById("exportCsvBtn")?.addEventListener("click", exportToCsv);
    document.getElementById("copyTableBtn")?.addEventListener("click", copyTable);
  </script>
</Base>
