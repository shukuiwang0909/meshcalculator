            </li>
            <li>
              <a href="/tools/inquiry-template-generator/" class="text-theme-secondary hover:text-theme-accent transition flex items-center gap-2">
                <span class="text-theme-accent">→</span> Inquiry Template Gen
              </a>
            </li>
          </ul>
        </div>

        <!-- Quick Specs -->
        <div class="bg-theme-card border border-theme rounded-lg p-5">
          <p class="text-xs font-semibold text-theme-accent tracking-widest mb-3">QUICK SPECS</p>
          <h3 class="text-sm font-bold text-theme-primary mb-3">Expanded Metal Standards</h3>
          <dl class="space-y-2 text-xs">
            <div class="flex justify-between">
              <dt class="text-theme-muted">SWD</dt>
              <dd class="text-theme-primary">10–100 mm</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-theme-muted">LWD</dt>
              <dd class="text-theme-primary">25–300 mm</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-theme-muted">Strand Width</dt>
              <dd class="text-theme-primary">0.8–6.0 mm</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-theme-muted">Sheet Thickness</dt>
              <dd class="text-theme-primary">0.5–6.0 mm</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-theme-muted">Materials</dt>
              <dd class="text-theme-primary">Steel / SS / Al / Cu</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-theme-muted">Standards</dt>
              <dd class="text-theme-primary">ASTM F1267<br/>ISO 9044</dd>
            </div>
          </dl>
        </div>

        <!-- Related Products -->
        <div class="bg-theme-card border border-theme rounded-lg p-5">
          <p class="text-xs font-semibold text-theme-accent tracking-widest mb-3">RELATED</p>
          <h3 class="text-sm font-bold text-theme-primary mb-3">Related Products</h3>
          <ul class="space-y-2 text-sm">
            <li>
              <a href="/products/perforated-metal/" class="text-theme-secondary hover:text-theme-accent transition flex items-center gap-2">
