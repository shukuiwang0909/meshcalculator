---
import BaseLayout from "../../layouts/Base.astro";

const title = "Wire Mesh Fence: Types, Specifications & Installation Guide";
const description = "Complete guide to wire mesh fencing for security, perimeter, and agricultural applications. Covers fence types, materials, height selection, and sourcing.";
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="bg-slate-900 text-white py-16">
    <div class="max-w-5xl mx-auto px-4">
      <h1 class="text-3xl md:text-4xl font-bold mb-4">Wire Mesh Fence Systems</h1>
      <p class="text-lg text-slate-300 max-w-2xl">
        From residential boundary marking to high-security perimeter protection,
        wire mesh fencing offers versatile, cost-effective solutions. This guide
        covers selection and sourcing.
      </p>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="max-w-5xl mx-auto px-4 py-4 text-sm text-slate-500">
    <a href="/" class="hover:text-amber-500">Home</a> / 
    <span>Applications</span> / 
    Fence
  </nav>

  <article class="max-w-5xl mx-auto px-4 py-8">
    <!-- Fence Types -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">Types of Wire Mesh Fencing</h2>
      <p class="text-slate-700 mb-4">
        Different fence types serve different security and functional requirements:
      </p>
      <div class="grid md:grid-cols-2 gap-4 mb-4">
        <div class="border border-slate-200 rounded p-4">
          <h3 class="font-semibold text-slate-900 mb-2">Welded Wire Fence Panels</h3>
          <p class="text-sm text-slate-700 mb-2">
            Rigid panels with welded intersections. Clean appearance, strong,
            difficult to climb or cut.
          </p>
          <ul class="text-sm text-slate-700 space-y-1">
            <li>Commercial and industrial perimeter security</li>
            <li>Parks, schools, public facilities</li>
            <li>3D curved panels for added rigidity</li>
          </ul>
        </div>
        <div class="border border-slate-200 rounded p-4">
          <h3 class="font-semibold text-slate-900 mb-2">Chain Link Fence</h3>
          <p class="text-sm text-slate-700 mb-2">
            Woven diamond pattern. Economical, quick to install, see-through.
          </p>
          <ul class="text-sm text-slate-700 space-y-1">
            <li>Residential boundaries</li>
            <li>Construction site temporary fencing</li>
            <li>Sports courts, tennis enclosures</li>
          </ul>
        </div>
        <div class="border border-slate-200 rounded p-4">
          <h3 class="font-semibold text-slate-900 mb-2">Palisade Fence</h3>
          <p class="text-sm text-slate-700 mb-2">
            Vertical steel pales with pointed tops. High security, intimidating appearance.
          </p>
          <ul class="text-sm text-slate-700 space-y-1">
            <li>Critical infrastructure protection</li>
            <li>Utilities, substations</li>
            <li>High-security facilities</li>
          </ul>
        </div>
        <div class="border border-slate-200 rounded p-4">
          <h3 class="font-semibold text-slate-900 mb-2">Field Fence / Farm Fence</h3>
          <p class="text-sm text-slate-700 mb-2">
            Woven knot construction. Withstands animal impact, economical for long runs.
          </p>
          <ul class="text-sm text-slate-700 space-y-1">
            <li>Cattle, horse enclosures</li>
            <li>Agricultural boundary fencing</li>
            <li>Wildlife exclusion</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Height Selection -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">Fence Height Selection</h2>
      <p class="text-slate-700 mb-4">
        Height determines both security level and cost:
      </p>
      <div class="overflow-x-auto mb-4">
        <table class="w-full text-sm">
          <thead class="bg-slate-100">
            <tr>
              <th class="text-left p-3 font-semibold text-slate-900">Height</th>
              <th class="text-left p-3 font-semibold text-slate-900">Typical Use</th>
              <th class="text-left p-3 font-semibold text-slate-900">Security Level</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr>
              <td class="p-3 text-slate-700">1.2m (4')</td>
              <td class="p-3 text-slate-700">Garden, residential boundary</td>
              <td class="p-3 text-slate-700">Basic delineation</td>
            </tr>
            <tr>
              <td class="p-3 text-slate-700">1.5m (5')</td>
              <td class="p-3 text-slate-700">Residential privacy, light commercial</td>
              <td class="p-3 text-slate-700">Low security</td>
            </tr>
            <tr>
              <td class="p-3 text-slate-700">1.8m (6')</td>
              <td class="p-3 text-slate-700">Commercial, school, park</td>
              <td class="p-3 text-slate-700">Medium security</td>
            </tr>
            <tr>
              <td class="p-3 text-slate-700">2.0-2.4m (6.5-8')</td>
              <td class="p-3 text-slate-700">Industrial, warehouse</td>
              <td class="p-3 text-slate-700">High security</td>
            </tr>
            <tr>
              <td class="p-3 text-slate-700">2.4m+ (8'+)</td>
              <td class="p-3 text-slate-700">Critical infrastructure, prison</td>
              <td class="p-3 text-slate-700">Maximum security</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Materials & Coatings -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">Materials & Coatings</h2>
      <p class="text-slate-700 mb-4">
        Coating choice significantly affects fence lifespan:
      </p>
      <ul class="list-disc pl-6 text-slate-700 space-y-2 mb-4">
        <li><strong>Galvanized (zinc)</strong> — Basic corrosion protection. 10-15 years outdoor life in moderate climates.</li>
        <li><strong>PVC coated</strong> — Polymer coating over galvanized wire. 15-25 years, color options (green, black, white).</li>
        <li><strong>Powder coated</strong> — Electrostatically applied polyester. Premium appearance, 20+ years.</li>
        <li><strong>Stainless steel</strong> — Maximum corrosion resistance. Coastal or chemical environments.</li>
      </ul>
      <p class="text-slate-700 mb-4">
        For coastal or high-humidity environments, specify heavier zinc coating
        (higher g/m²) or stainless steel. Standard commercial galvanized coating
        may fail prematurely in salt air.
      </p>
    </section>

    <!-- Complete Systems -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">Complete Fence Systems</h2>
      <p class="text-slate-700 mb-4">
        A functional fence requires more than mesh panels:
      </p>
      <ul class="list-disc pl-6 text-slate-700 space-y-2 mb-4">
        <li><strong>Posts</strong> — Square tube, round pipe, or I-beam. Set in concrete or driven.</li>
        <li><strong>Rails</strong> — Horizontal support for panel attachment.</li>
        <li><strong>Clamps/brackets</strong> — Connect panels to posts. Security fasteners resist tampering.</li>
        <li><strong>Gates</strong> — Matching mesh, sized for pedestrian or vehicle access.</li>
        <li><strong>Barbed wire extensions</strong> — Additional deterrence on security fences.</li>
        <li><strong>Privacy slats</strong> — Insert into chain link for visual screening.</li>
      </ul>
      <p class="text-slate-700 mb-4">
        When sourcing, clarify whether quotes include accessories. A "low" panel price
        may exclude posts and fittings that represent 30-40% of total system cost.
      </p>
    </section>

    <!-- Installation -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">Installation Considerations</h2>
      <div class="space-y-4 mb-4">
        <div class="border-l-4 border-amber-500 pl-4">
          <h3 class="font-semibold text-slate-900 mb-1">Post spacing</h3>
          <p class="text-sm text-slate-700">
            Standard spacing is 2.5-3m for welded panels, 3m for chain link.
            Closer spacing increases strength but also cost.
          </p>
        </div>
        <div class="border-l-4 border-amber-500 pl-4">
          <h3 class="font-semibold text-slate-900 mb-1">Foundation</h3>
          <p class="text-sm text-slate-700">
            Post holes typically 300mm diameter × 600mm deep (minimum), filled with
            concrete. Deeper in frost zones or high-wind areas.
          </p>
        </div>
        <div class="border-l-4 border-amber-500 pl-4">
          <h3 class="font-semibold text-slate-900 mb-1">Ground clearance</h3>
          <p class="text-sm text-slate-700">
            50-100mm gap prevents moisture wicking and allows drainage. For animal
            containment, consider bottom rail or buried mesh apron.
          </p>
        </div>
      </div>
    </section>

    <!-- Sourcing -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">Sourcing Fence Systems</h2>
      <p class="text-slate-700 mb-4">
        Key specification points for quotations:
      </p>
      <ul class="list-disc pl-6 text-slate-700 space-y-2 mb-4">
        <li>Panel dimensions (height × width) and wire diameter</li>
        <li>Mesh opening size (50×50mm, 75×75mm, etc.)</li>
        <li>Coating type and thickness (zinc g/m², PVC thickness)</li>
        <li>Post specifications (dimensions, wall thickness, coating)</li>
        <li>Accessory inclusion and specifications</li>
        <li>Gate requirements (size, type, hardware)</li>
      </ul>
      <p class="text-slate-700 mb-4">
        Use our <a href="/welded-wire-mesh-weight-calculator/" class="text-amber-600 hover:underline">welded mesh calculator</a> to estimate material
        weight for logistics planning.
      </p>
    </section>

    <!-- Related Pages -->
    <section class="mb-8">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">Continue Exploring</h2>
      <div class="grid md:grid-cols-2 gap-4">
        <a href="/products/wire-mesh-fence-panels/" class="block p-4 border border-slate-200 rounded hover:border-amber-500 transition">
          <h3 class="font-semibold text-slate-900 mb-1">Wire Mesh Fence Panels</h3>
          <p class="text-sm text-slate-600">Detailed specifications for fence panels</p>
        </a>
        <a href="/products/welded-wire-mesh/" class="block p-4 border border-slate-200 rounded hover:border-amber-500 transition">
          <h3 class="font-semibold text-slate-900 mb-1">Welded Wire Mesh</h3>
          <p class="text-sm text-slate-600">General welded mesh information</p>
        </a>
        <a href="/wire-mesh-hebei/" class="block p-4 border border-slate-200 rounded hover:border-amber-500 transition">
          <h3 class="font-semibold text-slate-900 mb-1">Hebei Wire Mesh</h3>
          <p class="text-sm text-slate-600">Manufacturing region overview</p>
        </a>
        <a href="/factory-directory/" class="block p-4 border border-slate-200 rounded hover:border-amber-500 transition">
          <h3 class="font-semibold text-slate-900 mb-1">Factory Directory</h3>
          <p class="text-sm text-slate-600">Browse fence system manufacturers</p>
        </a>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-slate-900 text-white rounded p-6 text-center">
      <h2 class="text-xl font-bold mb-2">Need a Fence System Quote?</h2>
      <p class="text-slate-300 mb-4">Send your project requirements. We'll connect you with qualified manufacturers.</p>
      <a href="/inquiry/" class="inline-block bg-amber-500 hover:bg-amber-400 text-slate-900 font-semibold px-6 py-2 rounded transition">
        Send Inquiry
      </a>
    </section>
  </article>
</BaseLayout>
