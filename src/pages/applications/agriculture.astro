---
import BaseLayout from '../../layouts/Base.astro';

const title = "Wire Mesh for Agriculture: Fencing, Netting & Livestock Applications";
const description = "Guide to wire mesh for farming and agricultural use. Covers livestock fencing, crop protection, greenhouse applications, and material selection for outdoor durability.";
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="bg-theme-secondary text-white py-16">
    <div class="max-w-5xl mx-auto px-4">
      <h1 class="text-3xl md:text-4xl font-bold mb-4">Wire Mesh for Agriculture</h1>
      <p class="text-lg text-theme-muted max-w-2xl">
        From livestock containment to crop protection, agricultural wire mesh must
        withstand weather, animals, and mechanical stress. This guide covers selection
        and sourcing for farming applications.
      </p>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="max-w-5xl mx-auto px-4 py-4 text-sm text-theme-muted">
    <a href="/" class="hover:text-theme-accent">Home</a> / 
    <span>Applications</span> / 
    Agriculture
  </nav>

  <article class="max-w-5xl mx-auto px-4 py-8">
    <!-- Overview -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-theme-primary mb-4">Agricultural Applications</h2>
      <p class="text-theme-secondary mb-4">
        Wire mesh serves diverse roles in modern agriculture, each with distinct
        performance requirements:
      </p>
      <ul class="list-disc pl-6 text-theme-secondary space-y-2 mb-4">
        <li><strong>Livestock fencing</strong> — Cattle, horse, sheep, and poultry containment</li>
        <li><strong>Crop protection</strong> — Bird netting, deer fencing, hail protection</li>
        <li><strong>Greenhouse construction</strong> — Bench tops, trellis systems, shade support</li>
        <li><strong>Storage</strong> — Grain bins, silage protection, hay stacking</li>
        <li><strong>Aquaculture</strong> — Fish farm cages, pond dividers, predator exclusion</li>
        <li><strong>Farm infrastructure</strong> — Machinery guards, ventilation screens, sorting pens</li>
      </ul>
    </section>

    <!-- Livestock Fencing -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-theme-primary mb-4">Livestock Fencing by Animal</h2>
      <p class="text-theme-secondary mb-4">
        Different animals require different fence designs:
      </p>
      <div class="overflow-x-auto mb-4">
        <table class="w-full text-sm">
          <thead class="bg-theme-tertiary">
            <tr>
              <th class="text-left p-3 font-semibold text-theme-primary">Animal</th>
              <th class="text-left p-3 font-semibold text-theme-primary">Recommended Fence</th>
              <th class="text-left p-3 font-semibold text-theme-primary">Height</th>
              <th class="text-left p-3 font-semibold text-theme-primary">Key Features</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-theme">
            <tr>
              <td class="p-3 font-medium text-theme-primary">Cattle</td>
              <td class="p-3 text-theme-secondary">Field fence, barbed wire</td>
              <td class="p-3 text-theme-secondary">1.2-1.5m</td>
              <td class="p-3 text-theme-secondary">High tensile, knot construction</td>
            </tr>
            <tr>
              <td class="p-3 font-medium text-theme-primary">Horses</td>
              <td class="p-3 text-theme-secondary">Field fence, woven wire</td>
              <td class="p-3 text-theme-secondary">1.4-1.6m</td>
              <td class="p-3 text-theme-secondary">Visible, no sharp edges, tight mesh bottom</td>
            </tr>
            <tr>
              <td class="p-3 font-medium text-theme-primary">Sheep/Goats</td>
              <td class="p-3 text-theme-secondary">Woven wire, netting</td>
              <td class="p-3 text-theme-secondary">1.0-1.2m</td>
              <td class="p-3 text-theme-secondary">Small bottom openings (15-20cm), predator proof</td>
            </tr>
            <tr>
              <td class="p-3 font-medium text-theme-primary">Poultry</td>
              <td class="p-3 text-theme-secondary">Hexagonal netting, welded mesh</td>
              <td class="p-3 text-theme-secondary">1.8-2.0m</td>
              <td class="p-3 text-theme-secondary">Small aperture (25-50mm), predator dig protection</td>
            </tr>
            <tr>
              <td class="p-3 font-medium text-theme-primary">Pigs</td>
              <td class="p-3 text-theme-secondary">Welded panels, heavy woven</td>
              <td class="p-3 text-theme-secondary">0.9-1.1m</td>
              <td class="p-3 text-theme-secondary">Strong, low to ground, dig-resistant</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Crop Protection -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-theme-primary mb-4">Crop Protection Mesh</h2>
      <p class="text-theme-secondary mb-4">
        Protecting crops from birds, animals, and weather:
      </p>
      <div class="grid md:grid-cols-2 gap-4 mb-4">
        <div class="border border-theme rounded p-4">
          <h3 class="font-semibold text-theme-primary mb-2">Bird Netting</h3>
          <p class="text-sm text-theme-secondary">
            Lightweight mesh (20-40mm aperture) draped over fruit trees, berry bushes,
            or vineyard rows. UV-stabilized polyethylene or polypropylene common.
            Wire mesh versions offer longer life for permanent installations.
          </p>
        </div>
        <div class="border border-theme rounded p-4">
          <h3 class="font-semibold text-theme-primary mb-2">Deer Fencing</h3>
          <p class="text-sm text-theme-secondary">
            Tall (2.0-2.4m) woven or welded mesh with small apertures. Must withstand
            deer impact and prevent fawns from entering. High-tensile wire recommended.
          </p>
        </div>
        <div class="border border-theme rounded p-4">
          <h3 class="font-semibold text-theme-primary mb-2">Hail Protection</h3>
          <p class="text-sm text-theme-secondary">
            Overhead netting with 6-10mm aperture. Reduces hail damage while allowing
            pollination and light penetration. Requires strong support structure.
          </p>
        </div>
        <div class="border border-theme rounded p-4">
          <h3 class="font-semibold text-theme-primary mb-2">Insect Screening</h3>
          <p class="text-sm text-theme-secondary">
            Fine mesh (0.6-1.2mm) for greenhouse ventilation openings. Prevents pest
            entry while maintaining airflow. UV-stabilized materials essential.
          </p>
        </div>
      </div>
    </section>

    <!-- Material Selection -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-theme-primary mb-4">Material Selection for Agriculture</h2>
      <p class="text-theme-secondary mb-4">
        Agricultural mesh faces unique challenges: UV exposure, animal contact,
        fertilizer chemicals, and mechanical stress from equipment.
      </p>
      <ul class="list-disc pl-6 text-theme-secondary space-y-2 mb-4">
        <li><strong>Galvanized steel</strong> — Standard for permanent fencing. Zinc coating 200-300g/m² for 15-20 year life.</li>
        <li><strong>PVC coated</strong> — Additional protection and color options (green, black). Popular for visible boundaries.</li>
        <li><strong>High-tensile steel</strong> — Higher strength allows lighter wire with equivalent performance. Reduces post spacing requirements.</li>
        <li><strong>Stainless steel</strong> — Premium option for corrosive environments (coastal, intensive livestock).</li>
        <li><strong>Polyethylene/polypropylene</strong> — Lightweight, UV-stabilized options for temporary or seasonal use.</li>
      </ul>
      <div class="bg-theme-tertiary border border-theme rounded p-4 mb-4">
        <p class="text-sm text-theme-accent">
          <strong>Cost insight:</strong> High-tensile wire costs 20-30% more than standard
          wire but allows 30-40% wider post spacing, reducing total fence cost. For long
          perimeter fences, high-tensile often wins on total installed cost.
        </p>
      </div>
    </section>

    <!-- Installation -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-theme-primary mb-4">Installation Considerations</h2>
      <div class="space-y-4 mb-4">
        <div class="border-l-4 border-theme-accent pl-4">
          <h3 class="font-semibold text-theme-primary mb-1">Post spacing</h3>
          <p class="text-sm text-theme-secondary">
            Standard: 8-12m for high-tensile field fence, 3-4m for welded panels.
            Corner and gate posts require additional bracing.
          </p>
        </div>
        <div class="border-l-4 border-theme-accent pl-4">
          <h3 class="font-semibold text-theme-primary mb-1">Terrain adaptation</h3>
          <p class="text-sm text-theme-secondary">
            On slopes, either step fence panels or use flexible woven mesh that follows
            contours. Woven field fence adapts better to rolling terrain than rigid panels.
          </p>
        </div>
        <div class="border-l-4 border-theme-accent pl-4">
          <h3 class="font-semibold text-theme-primary mb-1">Predator protection</h3>
          <p class="text-sm text-theme-secondary">
            For poultry and small livestock, bury mesh 30cm or add ground-level apron
            to prevent digging predators (foxes, coyotes, dogs).
          </p>
        </div>
        <div class="border-l-4 border-theme-accent pl-4">
          <h3 class="font-semibold text-theme-primary mb-1">Gates and access</h3>
          <p class="text-sm text-theme-secondary">
            Plan gate locations for equipment access and animal movement. Gate width
            determines machinery access; 3.6m minimum for tractors, 6m+ for combines.
          </p>
        </div>
      </div>
    </section>

    <!-- Sourcing -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-theme-primary mb-4">Sourcing Agricultural Mesh</h2>
      <p class="text-theme-secondary mb-4">
        Key specification points:
      </p>
      <ul class="list-disc pl-6 text-theme-secondary space-y-2 mb-4">
        <li>Mesh type (woven field fence, welded panels, hexagonal netting)</li>
        <li>Wire diameter and tensile strength</li>
        <li>Zinc coating weight (g/m²) or coating type</li>
        <li>Roll or panel dimensions</li>
        <li>Edge finish (plain, knotted, reinforced)</li>
        <li>UV stabilization (for polymer meshes)</li>
      </ul>
      <p class="text-theme-secondary mb-4">
        For large perimeter projects, use our <a href="/tools/welded-wire-mesh-weight-calculator/" class="text-theme-accent hover:underline">weight calculator</a> to
        estimate total material and shipping costs.
      </p>
    </section>

    <!-- Related Pages -->
    <section class="mb-8">
      <h2 class="text-2xl font-bold text-theme-primary mb-4">Continue Exploring</h2>
      <div class="grid md:grid-cols-2 gap-4">
        <a href="/applications/fence/" class="block p-4 border border-theme rounded hover:border-theme-accent transition">
          <h3 class="font-semibold text-theme-primary mb-1">Wire Mesh Fence Systems</h3>
          <p class="text-sm text-theme-secondary">General fencing types and specifications</p>
        </a>
        <a href="/products/wire-mesh-fence-panels/" class="block p-4 border border-theme rounded hover:border-theme-accent transition">
          <h3 class="font-semibold text-theme-primary mb-1">Fence Panels</h3>
          <p class="text-sm text-theme-secondary">Rigid panel specifications for farm use</p>
        </a>
        <a href="/products/gabion-baskets/" class="block p-4 border border-theme rounded hover:border-theme-accent transition">
          <h3 class="font-semibold text-theme-primary mb-1">Gabion Baskets</h3>
          <p class="text-sm text-theme-secondary">Erosion control and land management</p>
        </a>
        <a href="/anping-wire-mesh/" class="block p-4 border border-theme rounded hover:border-theme-accent transition">
          <h3 class="font-semibold text-theme-primary mb-1">Anping Wire Mesh</h3>
          <p class="text-sm text-theme-secondary">Manufacturing hub for agricultural mesh</p>
        </a>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-theme-secondary text-white rounded p-6 text-center">
      <h2 class="text-xl font-bold mb-2">Need Agricultural Mesh?</h2>
      <p class="text-theme-muted mb-4">Send your project requirements. We'll connect you with qualified manufacturers.</p>
      <a href="/inquiry/" class="inline-block accent-bg hover:accent-bg text-theme-primary font-semibold px-6 py-2 rounded transition">
        Send Inquiry
      </a>
    </section>
  </article>
</BaseLayout>
