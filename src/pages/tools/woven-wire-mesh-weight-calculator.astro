---
import Base from "../../layouts/Base.astro";

const origin = "https://meshcalculator.com";

const extraJsonLd = [
  {
    "@type": "SoftwareApplication",
    name: "Woven Wire Mesh Weight Calculator",
    url: `${origin}/tools/woven-wire-mesh-weight-calculator/`,
    applicationCategory: "UtilityApplication",
    operatingSystem: "Web",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    description: "Free online tool to calculate the theoretical weight of woven wire mesh per m² or lb/ft² from mesh count and wire diameter, supporting plain and twill weave in stainless steel, brass, copper, and aluminum.",
  },
  {
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "What is the formula for woven wire mesh weight?",
        acceptedAnswer: { "@type": "Answer", text: "Plain-weave woven mesh weight per m² is calculated as: kg/m² = 0.0618 × ρ × mesh × d², where ρ is material density in g/cm³, mesh is openings per inch, and d is wire diameter in mm. Twill weave uses approximately twice the wire length and thus doubles this value." },
      },
      {
        "@type": "Question",
        name: "How does mesh count affect the weight of woven wire mesh?",
        acceptedAnswer: { "@type": "Answer", text: "Weight increases linearly with mesh count for the same wire diameter — doubling the mesh count doubles the weight per m². Higher mesh counts also reduce the opening size, so the wire diameter must be reduced proportionally to keep a usable aperture." },
      },
      {
        "@type": "Question",
        name: "What is the difference in weight between plain weave and twill weave?",
        acceptedAnswer: { "@type": "Answer", text: "Twill weave uses roughly twice the wire length of plain weave because each wire passes over and under two wires at a time instead of one, creating a longer crimp path. This approximately doubles the weight per m² for the same mesh count and wire diameter." },
      },
      {
        "@type": "Question",
        name: "How accurate is the woven wire mesh weight calculation?",
        acceptedAnswer: { "@type": "Answer", text: "The result is a theoretical value for plain weave without crimp deduction. Actual roll weight typically varies ±5% with weaving tension, wire diameter tolerance, and edge finish. Use it to compare supplier quotes and estimate freight — always confirm with your factory." },
      },
    ],
  },
];
---
<Base title="Woven Wire Mesh Weight Calculator — Free | MeshCalculator" description="Calculate woven wire mesh weight (kg/m² or lb/ft²) from mesh count and wire diameter. Stainless steel, plain and twill weave. Free, no signup." extraJsonLd={extraJsonLd}>
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-theme-primary">Woven Wire Mesh Weight Calculator</h1>
    <p class="mt-2 text-theme-secondary">Theoretical weight for plain-weave wire mesh. Used for freight estimation and quote comparison.</p>

    <div class="mt-8 bg-theme-card border border-theme rounded-xl p-6 grid md:grid-cols-2 gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold mb-1 text-theme-primary" for="material">Material</label>
          <select id="material" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary">
            <option value="7.85">Carbon steel (7.85 g/cm³)</option>
            <option value="7.9" selected>Stainless steel 304/316 (7.9 g/cm³)</option>
            <option value="8.8">Brass (8.8 g/cm³)</option>
            <option value="8.9">Copper (8.9 g/cm³)</option>
            <option value="2.7">Aluminum (2.7 g/cm³)</option>
            <option value="custom">Custom density…</option>
          </select>
        </div>
        <div id="customDensityWrap" class="hidden">
          <label class="block text-sm font-semibold mb-1 text-theme-primary" for="customDensity">Custom density (g/cm³)</label>
          <input id="customDensity" type="number" step="0.01" value="7.85" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary" />
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1 text-theme-primary" for="mesh">Mesh count (per inch)</label>
          <input id="mesh" type="number" step="1" min="1" value="100" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary" />
          <p class="text-xs text-theme-muted mt-1">e.g. 100 = 100 openings per linear inch</p>
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1 text-theme-primary" for="diameter">Wire diameter (mm)</label>
          <input id="diameter" type="number" step="0.001" min="0.01" value="0.10" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary" />
        </div>
        <div>
          <label class="flex items-center gap-2 text-sm font-semibold text-theme-primary">
            <input id="twill" type="checkbox" class="rounded border-theme" /> Twill weave (2× wire length factor)
          </label>
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1 text-theme-primary">Units</label>
          <div class="flex gap-4 text-sm text-theme-secondary">
            <label class="flex items-center gap-1"><input type="radio" name="unit" value="metric" checked class="rounded border-theme" />kg/m²</label>
            <label class="flex items-center gap-1"><input type="radio" name="unit" value="imperial" class="rounded border-theme" />lb/ft²</label>
          </div>
        </div>
      </div>

      <div class="bg-theme-tertiary rounded-lg p-6 flex flex-col justify-center border border-theme">
        <p class="text-sm font-semibold text-theme-muted uppercase tracking-wide">Theoretical weight</p>
        <p id="result" class="text-4xl font-bold mt-2 text-theme-primary">—</p>
        <div class="mt-4 text-sm text-theme-secondary space-y-1">
          <p>Opening size: <span id="opening" class="font-semibold text-theme-primary">—</span></p>
          <p>Open area: <span id="openarea" class="font-semibold text-theme-primary">—</span></p>
        </div>
        <div class="mt-6 flex flex-wrap gap-2">
          <button id="copyBtn" class="accent-bg text-sm font-semibold px-4 py-2 rounded-lg hover:opacity-90 transition-opacity on-accent">Copy Result</button>
          <button id="shareBtn" class="border border-theme text-sm font-semibold px-4 py-2 rounded-lg hover:border-theme-muted transition-colors text-theme-primary">Share Link</button>
          <button id="printBtn" class="border border-theme text-sm font-semibold px-4 py-2 rounded-lg hover:border-theme-muted transition-colors text-theme-primary">Print</button>
        </div>
      </div>
    </div>

    <div class="mt-10 prose max-w-none text-theme-secondary">
      <h2 class="text-xl font-bold text-theme-primary">How it works</h2>
      <p>
        Weight per square meter for plain-weave mesh is calculated as:
      </p>
      <p class="bg-theme-tertiary border border-theme rounded-lg px-4 py-3 font-mono text-sm text-theme-primary">
        kg/m² = 0.0618 × ρ × mesh × d²
      </p>
      <p>
        where ρ = material density (g/cm³), mesh = openings per inch, d = wire diameter (mm).
        Twill weave uses roughly twice the wire length of plain weave.
        For a 100-mesh, 0.10 mm stainless steel mesh this gives ≈ 0.49 kg/m².
      </p>
      <p class="text-sm text-theme-muted">
        Note: theoretical value for plain weave without crimp deduction. Actual roll weight varies ±5% with weaving tension and edge finish.
        Use it to compare quotes and estimate freight — always confirm with your factory.
      </p>
    </div>
  </section>

  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const material = $("material"), customWrap = $("customDensityWrap"), customD = $("customDensity");
    const mesh = $("mesh"), dia = $("diameter"), twill = $("twill");

    function density(): number {
      if (material.value === "custom") { customWrap.classList.remove("hidden"); return parseFloat(customD.value) || 7.85; }
      customWrap.classList.add("hidden");
      return parseFloat(material.value);
    }
    function unit(): string { return (document.querySelector('input[name="unit"]:checked') as HTMLInputElement).value; }

    function calc() {
      const n = parseFloat(mesh.value), d = parseFloat(dia.value), rho = density();
      if (!n || !d || n <= 0 || d <= 0) { $("result").textContent = "—"; return; }
      let kg = 0.0618 * rho * n * d * d;
      if (twill.checked) kg *= 2;
      const imperial = unit() === "imperial";
      $("result").textContent = imperial ? (kg * 0.2048).toFixed(3) + " lb/ft²" : kg.toFixed(3) + " kg/m²";
      const openingMm = 25.4 / n - d;
      $("opening").textContent = openingMm > 0 ? openingMm.toFixed(3) + " mm" : "n/a (d too large)";
      const oa = Math.max(0, (1 - (n * d) / 25.4) ** 2 * 100);
      $("openarea").textContent = oa.toFixed(1) + " %";
    }
    function copyResult() {
      const result = $("result").textContent;
      const opening = $("opening").textContent;
      const openarea = $("openarea").textContent;
      const materialText = material.options[material.selectedIndex].text;
      const meshVal = mesh.value;
      const diaVal = dia.value;
      const twillText = twill.checked ? "Twill weave" : "Plain weave";
      const unitText = unit() === "imperial" ? "lb/ft²" : "kg/m²";
      
      const text = `Woven Wire Mesh Calculation
Material: ${materialText}
Mesh: ${meshVal} per inch
Wire Diameter: ${diaVal} mm
Weave: ${twillText}

Result: ${result}
Opening: ${opening}
Open Area: ${openarea}

Calculated with MeshCalculator`;
      
      navigator.clipboard.writeText(text).then(() => {
        const btn = $("copyBtn");
        const original = btn.textContent;
        btn.textContent = "Copied!";
        setTimeout(() => { btn.textContent = original; }, 2000);
      });
    }

    function shareLink() {
      const params = new URLSearchParams({
        mesh: mesh.value,
        dia: dia.value,
        twill: twill.checked ? "1" : "0",
        unit: unit(),
        mat: material.value
      });
      const url = window.location.origin + window.location.pathname + "?" + params.toString();
      navigator.clipboard.writeText(url).then(() => {
        const btn = $("shareBtn");
        const original = btn.textContent;
        btn.textContent = "Link Copied!";
        setTimeout(() => { btn.textContent = original; }, 2000);
      });
    }

    [mesh, dia, twill, customD].forEach((el) => el.addEventListener("input", calc));
    material.addEventListener("change", calc);
    document.querySelectorAll('input[name="unit"]').forEach((r) => r.addEventListener("change", calc));
    $("printBtn").addEventListener("click", () => window.print());
    $("copyBtn").addEventListener("click", copyResult);
    $("shareBtn").addEventListener("click", shareLink);

    // Load from URL params
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get("mesh")) mesh.value = urlParams.get("mesh")!;
    if (urlParams.get("dia")) dia.value = urlParams.get("dia")!;
    if (urlParams.get("twill") === "1") twill.checked = true;
    if (urlParams.get("mat")) material.value = urlParams.get("mat")!;
    if (urlParams.get("unit")) {
      const radio = document.querySelector(`input[name="unit"][value="${urlParams.get("unit")}"]`) as HTMLInputElement;
      if (radio) radio.checked = true;
    }

    calc();
  </script>
  <section class="max-w-6xl mx-auto px-4 py-8">
    <h2 class="text-xl font-bold text-theme-primary mb-4">Related Guides</h2>
    <div class="grid md:grid-cols-3 gap-4">
        <a href="/blog/how-to-calculate-wire-mesh-weight/" class="bg-theme-card border border-theme rounded-lg p-4 hover:border-theme-primary transition block">
          <div class="font-semibold text-theme-primary">How to Calculate Mesh Weight</div>
          <div class="text-sm text-theme-secondary">The formula behind the tool</div>
        </a>
        <a href="/blog/wire-mesh-size-chart-explained/" class="bg-theme-card border border-theme rounded-lg p-4 hover:border-theme-primary transition block">
          <div class="font-semibold text-theme-primary">Mesh Size Chart Explained</div>
          <div class="text-sm text-theme-secondary">Specs that drive weight</div>
        </a>
        <a href="https://steelgratingcalculator.com/tools/steel-grating-weight-calculator/" class="bg-theme-card border border-theme rounded-lg p-4 hover:border-theme-primary transition block" target="_blank" rel="noopener">
          <div class="font-semibold text-theme-primary">Steel Grating Weight Calculator</div>
          <div class="text-sm text-theme-secondary">Also from Anping — bar grating kg/m² tool</div>
        </a>
    </div>
  </section>
</Base>
