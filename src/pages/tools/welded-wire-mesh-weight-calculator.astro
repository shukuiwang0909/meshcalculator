---
import Base from "../../layouts/Base.astro";
---
<Base title="Welded Wire Mesh Weight Calculator — Free | MeshCalculator" description="Calculate welded wire mesh panel or roll weight from opening size, wire diameter and dimensions. Steel & stainless. Free, no signup.">
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-theme-primary">Welded Wire Mesh Weight Calculator</h1>
    <p class="mt-2 text-theme-secondary">For welded panels and rolls (fence mesh, reinforcing mesh). Get weight per m² or for a whole sheet.</p>

    <div class="mt-8 bg-theme-card border border-theme rounded-xl p-6 grid md:grid-cols-2 gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold mb-1 text-theme-primary" for="material">Material</label>
          <select id="material" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary">
            <option value="7.85" selected>Galvanized / carbon steel (7.85 g/cm³)</option>
            <option value="7.9">Stainless steel (7.9 g/cm³)</option>
            <option value="2.7">Aluminum (2.7 g/cm³)</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold mb-1 text-theme-primary" for="openShort">Opening — short side (mm)</label>
            <input id="openShort" type="number" step="0.1" value="50.8" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary" />
          </div>
          <div>
            <label class="block text-sm font-semibold mb-1 text-theme-primary" for="openLong">Opening — long side (mm)</label>
            <input id="openLong" type="number" step="0.1" value="50.8" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary" />
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1 text-theme-primary" for="dia">Wire diameter (mm)</label>
          <input id="dia" type="number" step="0.05" value="2.5" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary" />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold mb-1 text-theme-primary" for="width">Sheet width (m)</label>
            <input id="width" type="number" step="0.1" value="1.22" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary" />
          </div>
          <div>
            <label class="block text-sm font-semibold mb-1 text-theme-primary" for="height">Sheet height (m)</label>
            <input id="height" type="number" step="0.1" value="2.44" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary" />
          </div>
        </div>
      </div>

      <div class="bg-theme-tertiary rounded-lg p-6 flex flex-col justify-center border border-theme">
        <p class="text-sm font-semibold text-theme-muted uppercase tracking-wide">Theoretical weight</p>
        <p id="resultKg" class="text-4xl font-bold mt-2 text-theme-primary">—</p>
        <p id="resultSheet" class="mt-2 text-lg text-theme-secondary">—</p>
        <button id="printBtn" class="mt-6 self-start accent-bg text-sm font-semibold px-4 py-2 rounded-lg hover:opacity-90 transition-opacity" style="color: #07090c;">Print / Save result</button>
      </div>
    </div>

    <div class="mt-10 prose max-w-none text-theme-secondary">
      <h2 class="text-xl font-bold text-theme-primary">Formula</h2>
      <p class="bg-theme-tertiary border border-theme rounded-lg px-4 py-3 font-mono text-sm text-theme-primary">
        kg/m² = 1.571 × ρ × d² ÷ (opening + d)
      </p>
      <p>
        where ρ = density (g/cm³), d = wire diameter (mm), opening = hole size (mm). Galvanized zinc coating adds ~3–5% weight.
        Example: 50.8 × 50.8 mm opening, 2.5 mm galvanized wire → ≈ 1.44 kg/m², a standard 1.22 × 2.44 m panel ≈ 4.3 kg.
      </p>
      <p class="text-sm text-theme-muted">Theoretical estimate for reference only; confirm with factory before booking freight.</p>
    </div>
  </section>

  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const ids = ["material", "openShort", "openLong", "dia", "width", "height"];
    function calc() {
      const rho = parseFloat($("material").value);
      const os = parseFloat($("openShort").value), ol = parseFloat($("openLong").value);
      const d = parseFloat($("dia").value);
      const w = parseFloat($("width").value), h = parseFloat($("height").value);
      if (!os || !ol || !d) { $("resultKg").textContent = "—"; $("resultSheet").textContent = ""; return; }
      const pitchS = os + d, pitchL = ol + d;
      const exact = (1000 / pitchS + 1000 / pitchL) * 0.7854 * d * d * 1e-6 * rho * 1000;
      $("resultKg").textContent = exact.toFixed(2) + " kg/m²";
      const sheet = w > 0 && h > 0 ? exact * w * h : 0;
      $("resultSheet").textContent = sheet ? `Sheet (${w} × ${h} m): ≈ ${sheet.toFixed(1)} kg` : "";
    }
    ids.forEach((id) => $(id).addEventListener("input", calc));
    $("printBtn").addEventListener("click", () => window.print());
    calc();
  </script>
</Base>
