---
import Base from "../../layouts/Base.astro";
---

<Base title="FOB Price Calculator — Multi-Currency Export Quote Tool | MeshCalculator" description="Convert RMB factory price to FOB USD/EUR/GBP quotes. Includes freight estimation, profit margin, and real-time exchange rates. Free tool for wire mesh sourcing.">
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-theme-primary">FOB Price Calculator</h1>
    <p class="mt-2 text-theme-secondary">Convert Chinese factory price (RMB) to FOB export quotes in USD, EUR, or GBP. Includes freight, profit margin, and exchange rate conversion.</p>

    <div class="mt-8 bg-theme-card border border-theme rounded-xl p-6 grid md:grid-cols-2 gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold mb-1 text-theme-primary" for="productType">Product Type</label>
          <select id="productType" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary">
            <option value="woven">Woven Wire Mesh</option>
            <option value="welded">Welded Wire Mesh</option>
            <option value="fence">Fence Panels</option>
            <option value="gabion">Gabion Baskets</option>
            <option value="custom">Custom Product</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1 text-theme-primary" for="rmbPrice">Factory Price (RMB)</label>
          <input id="rmbPrice" type="number" step="0.01" min="0" value="25.00" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary" />
          <p class="text-xs text-theme-muted mt-1">Per unit (kg, m², piece, etc.)</p>
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1 text-theme-primary" for="quantity">Quantity</label>
          <input id="quantity" type="number" step="1" min="1" value="1000" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary" />
          <p class="text-xs text-theme-muted mt-1">Total units for this order</p>
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1 text-theme-primary" for="profitMargin">Profit Margin (%)</label>
          <input id="profitMargin" type="number" step="0.1" min="0" max="100" value="15" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary" />
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1 text-theme-primary" for="freightCost">Freight to Port (RMB)</label>
          <input id="freightCost" type="number" step="0.01" min="0" value="3500" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary" />
          <p class="text-xs text-theme-muted mt-1">Trucking + handling to Tianjin/Qingdao</p>
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1 text-theme-primary" for="exchangeRate">Exchange Rate (USD/CNY)</label>
          <div class="flex gap-2">
            <input id="exchangeRate" type="number" step="0.0001" min="0" value="7.25" class="flex-1 border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary" />
            <button id="fetchRate" class="accent-bg text-sm font-semibold px-4 py-2 rounded-lg hover:opacity-90 transition-opacity whitespace-nowrap" style="color: #07090c;">Fetch Live</button>
          </div>
          <p class="text-xs text-theme-muted mt-1">Auto-fetched from exchangerate-api.com</p>
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1 text-theme-primary">Target Currency</label>
          <div class="flex gap-4 text-sm text-theme-secondary">
            <label class="flex items-center gap-1"><input type="radio" name="currency" value="USD" checked class="rounded border-theme" />USD ($)</label>
            <label class="flex items-center gap-1"><input type="radio" name="currency" value="EUR" class="rounded border-theme" />EUR (€)</label>
            <label class="flex items-center gap-1"><input type="radio" name="currency" value="GBP" class="rounded border-theme" />GBP (£)</label>
          </div>
        </div>
      </div>

      <div class="bg-theme-tertiary rounded-lg p-6 flex flex-col justify-center border border-theme">
        <p class="text-sm font-semibold text-theme-muted uppercase tracking-wide">FOB Unit Price</p>
        <p id="fobResult" class="text-4xl font-bold mt-2 text-theme-primary">—</p>
        
        <div class="mt-6 text-sm text-theme-secondary space-y-2">
          <div class="flex justify-between">
            <span>Total Order Value:</span>
            <span id="totalValue" class="font-semibold text-theme-primary">—</span>
          </div>
          <div class="flex justify-between">
            <span>Cost per Unit (RMB):</span>
            <span id="unitCost" class="font-semibold text-theme-primary">—</span>
          </div>
          <div class="flex justify-between">
            <span>Freight per Unit:</span>
            <span id="freightUnit" class="font-semibold text-theme-primary">—</span>
          </div>
          <div class="flex justify-between">
            <span>Exchange Rate:</span>
            <span id="rateDisplay" class="font-semibold text-theme-primary">—</span>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-2">
          <button id="copyBtn" class="accent-bg text-sm font-semibold px-4 py-2 rounded-lg hover:opacity-90 transition-opacity" style="color: #07090c;">Copy Result</button>
          <button id="shareBtn" class="border border-theme text-sm font-semibold px-4 py-2 rounded-lg hover:border-theme-muted transition-colors text-theme-primary">Share Link</button>
          <button id="printBtn" class="border border-theme text-sm font-semibold px-4 py-2 rounded-lg hover:border-theme-muted transition-colors text-theme-primary">Print</button>
        </div>
      </div>
    </div>

    <div class="mt-10 prose max-w-none text-theme-secondary">
      <h2 class="text-xl font-bold text-theme-primary">How FOB Pricing Works</h2>
      <p>
        FOB (Free On Board) means the seller covers all costs until the goods are loaded on the vessel at the port of shipment. 
        For Anping wire mesh exports, this typically includes:
      </p>
      <ul class="list-disc pl-6 space-y-2">
        <li><strong>Factory price</strong> — RMB per kg/m²/piece from the manufacturer</li>
        <li><strong>Domestic freight</strong> — trucking from Anping to Tianjin/Qingdao port (~220km)</li>
        <li><strong>Export handling</strong> — customs clearance, documentation, port fees (~¥800-1500)</li>
        <li><strong>Your margin</strong> — profit percentage for trading companies or sourcing agents</li>
      </ul>
      
      <h3 class="text-lg font-bold text-theme-primary mt-6">Example Calculation</h3>
      <div class="bg-theme-tertiary border border-theme rounded-lg p-4 font-mono text-sm text-theme-primary">
        <p>Product: Stainless steel woven mesh 100 mesh × 0.10mm</p>
        <p>Factory price: ¥25.00/kg</p>
        <p>Quantity: 1,000 kg</p>
        <p>Freight to port: ¥3,500</p>
        <p>Margin: 15%</p>
        <p class="mt-2">→ FOB price: <span class="accent-text font-bold">$4.38/kg</span> (at 7.25 USD/CNY)</p>
      </div>

      <div class="mt-6 p-4 border border-theme rounded-lg bg-theme-card">
        <p class="text-sm text-theme-muted">
          <strong class="text-theme-primary">Note:</strong> Exchange rates are for reference only. Actual bank rates may differ by 0.5-2%. 
          Always confirm rates with your bank or payment provider before finalizing contracts.
        </p>
      </div>
    </div>
  </section>

  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const rmbPrice = $("rmbPrice"), quantity = $("quantity"), profitMargin = $("profitMargin");
    const freightCost = $("freightCost"), exchangeRate = $("exchangeRate");
    const fetchRateBtn = $("fetchRate");

    function getCurrency(): string {
      return (document.querySelector('input[name="currency"]:checked') as HTMLInputElement).value;
    }

    function getCurrencySymbol(currency: string): string {
      const symbols: Record<string, string> = { USD: "$", EUR: "€", GBP: "£" };
      return symbols[currency] || "$";
    }

    async function fetchLiveRate() {
      const btn = fetchRateBtn;
      const originalText = btn.textContent;
      btn.textContent = "Fetching...";
      btn.disabled = true;
      
      try {
        // Use open.er-api.com (CORS-friendly)
        const response = await fetch("https://open.er-api.com/v6/latest/USD");
        const data = await response.json();
        if (data && data.rates && data.rates.CNY) {
          exchangeRate.value = data.rates.CNY.toFixed(4);
          calc();
        }
      } catch (e) {
        console.error("Failed to fetch exchange rate:", e);
        btn.textContent = "Failed";
        setTimeout(() => {
          btn.textContent = originalText;
          btn.disabled = false;
        }, 2000);
        return;
      }
      
      btn.textContent = "Updated!";
      setTimeout(() => {
        btn.textContent = originalText;
        btn.disabled = false;
      }, 2000);
    }

    function calc() {
      const price = parseFloat(rmbPrice.value) || 0;
      const qty = parseInt(quantity.value) || 0;
      const margin = parseFloat(profitMargin.value) || 0;
      const freight = parseFloat(freightCost.value) || 0;
      const rate = parseFloat(exchangeRate.value) || 7.25;
      const currency = getCurrency();
      const symbol = getCurrencySymbol(currency);

      if (!price || !qty || !rate) {
        $("fobResult").textContent = "—";
        $("totalValue").textContent = "—";
        $("unitCost").textContent = "—";
        $("freightUnit").textContent = "—";
        $("rateDisplay").textContent = "—";
        return;
      }

      // Calculate total cost in RMB
      const totalRmbCost = (price * qty) + freight;
      const freightPerUnit = freight / qty;
      const costPerUnit = price + freightPerUnit;
      
      // Add profit margin
      const sellingPriceRmb = costPerUnit * (1 + margin / 100);
      
      // Convert to target currency
      const fobPrice = sellingPriceRmb / rate;
      const totalValue = fobPrice * qty;

      $("fobResult").textContent = symbol + fobPrice.toFixed(2) + "/" + getUnit();
      $("totalValue").textContent = symbol + totalValue.toLocaleString(undefined, { maximumFractionDigits: 0 });
      $("unitCost").textContent = "¥" + costPerUnit.toFixed(2);
      $("freightUnit").textContent = "¥" + freightPerUnit.toFixed(2);
      $("rateDisplay").textContent = rate.toFixed(4) + " " + currency + "/CNY";
    }

    function getUnit(): string {
      const productType = ($("productType") as HTMLSelectElement).value;
      const units: Record<string, string> = {
        woven: "kg", welded: "m²", fence: "panel", gabion: "piece", custom: "unit"
      };
      return units[productType] || "unit";
    }

    function copyResult() {
      const text = `FOB Quote: ${$("fobResult").textContent}\nTotal: ${$("totalValue").textContent}\nRate: ${$("rateDisplay").textContent}\n\nCalculated with MeshCalculator FOB Price Calculator`;
      navigator.clipboard.writeText(text).then(() => {
        const btn = $("copyBtn");
        const originalText = btn.textContent;
        btn.textContent = "Copied!";
        setTimeout(() => { btn.textContent = originalText; }, 2000);
      });
    }

    function shareLink() {
      const params = new URLSearchParams({
        price: rmbPrice.value,
        qty: quantity.value,
        margin: profitMargin.value,
        freight: freightCost.value,
        rate: exchangeRate.value,
        currency: getCurrency()
      });
      const url = window.location.origin + window.location.pathname + "?" + params.toString();
      navigator.clipboard.writeText(url).then(() => {
        const btn = $("shareBtn");
        const originalText = btn.textContent;
        btn.textContent = "Link Copied!";
        setTimeout(() => { btn.textContent = originalText; }, 2000);
      });
    }

    // Event listeners
    [rmbPrice, quantity, profitMargin, freightCost, exchangeRate].forEach(el => {
      el.addEventListener("input", calc);
    });
    document.querySelectorAll('input[name="currency"]').forEach(r => {
      r.addEventListener("change", calc);
    });
    $("productType").addEventListener("change", calc);
    fetchRateBtn.addEventListener("click", fetchLiveRate);
    $("copyBtn").addEventListener("click", copyResult);
    $("shareBtn").addEventListener("click", shareLink);
    $("printBtn").addEventListener("click", () => window.print());

    // Load from URL params if present
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get("price")) rmbPrice.value = urlParams.get("price")!;
    if (urlParams.get("qty")) quantity.value = urlParams.get("qty")!;
    if (urlParams.get("margin")) profitMargin.value = urlParams.get("margin")!;
    if (urlParams.get("freight")) freightCost.value = urlParams.get("freight")!;
    if (urlParams.get("rate")) exchangeRate.value = urlParams.get("rate")!;
    if (urlParams.get("currency")) {
      const radio = document.querySelector(`input[name="currency"][value="${urlParams.get("currency")}"]`) as HTMLInputElement;
      if (radio) radio.checked = true;
    }

    calc();
  </script>
  <section class="max-w-6xl mx-auto px-4 py-8">
    <h2 class="text-xl font-bold text-theme-primary mb-4">Related Guides</h2>
    <div class="grid md:grid-cols-3 gap-4">
        <a href="/blog/why-anping-wire-mesh-is-cheap/" class="bg-theme-card border border-theme rounded-lg p-4 hover:border-theme-primary transition block">
          <div class="font-semibold text-theme-primary">Why Anping Mesh Is Cheap</div>
          <div class="text-sm text-theme-secondary">Understanding factory quotes</div>
        </a>
        <a href="/blog/reduce-wire-mesh-import-cost/" class="bg-theme-card border border-theme rounded-lg p-4 hover:border-theme-primary transition block">
          <div class="font-semibold text-theme-primary">Reduce Import Costs</div>
          <div class="text-sm text-theme-secondary">8 levers to cut landed cost</div>
        </a>
    </div>
  </section>
</Base>
