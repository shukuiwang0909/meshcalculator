---
import Base from "../../layouts/Base.astro";
const sieveTable: [number, number][] = [
  [4, 4750], [6, 3350], [8, 2360], [10, 2000], [12, 1700], [14, 1400], [16, 1180],
  [18, 1000], [20, 850], [25, 710], [30, 600], [35, 500], [40, 425], [45, 355],
  [50, 300], [60, 250], [70, 212], [80, 180], [100, 150], [120, 125], [140, 106],
  [170, 90], [200, 75], [230, 63], [270, 53], [325, 45], [400, 38],
];

const origin = "https://meshcalculator.com";

const extraJsonLd = [
  {
    "@type": "SoftwareApplication",
    name: "Mesh Count to Micron Converter",
    url: `${origin}/tools/mesh-count-conversion/`,
    applicationCategory: "UtilityApplication",
    operatingSystem: "Web",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    description: "Free online tool to convert wire mesh count (openings per inch) to opening size in microns, millimeters, and inches. Includes ASTM E11 standard sieve series reference table.",
  },
  {
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "What does mesh count mean for wire mesh?",
        acceptedAnswer: { "@type": "Answer", text: "Mesh count is the number of openings per linear inch. A 100-mesh screen has 100 openings per inch. Higher mesh count means smaller openings and finer filtration. The actual opening size depends on both the mesh count and the wire diameter." },
      },
      {
        "@type": "Question",
        name: "How do I convert mesh count to microns?",
        acceptedAnswer: { "@type": "Answer", text: "The opening size in mm = 25.4 / mesh − wire diameter. Multiply by 1,000 to get microns. For example, 100-mesh with 0.10 mm wire gives an opening of 0.154 mm = 154 µm. The ASTM E11 sieve table gives nominal openings for standard sieve sizes." },
      },
      {
        "@type": "Question",
        name: "What is the ASTM E11 standard for wire mesh sieves?",
        acceptedAnswer: { "@type": "Answer", text: "ASTM E11 specifies standard wire cloth test sieves used in particle size analysis. It defines nominal opening sizes from 38 µm (400 mesh) to 4,750 µm (4 mesh), with tolerances on wire diameter and opening uniformity. The same designations are used in ISO 565." },
      },
      {
        "@type": "Question",
        name: "Why does the same mesh count have different opening sizes from different suppliers?",
        acceptedAnswer: { "@type": "Answer", text: "Opening size equals 25.4/mesh − wire diameter. Different wire diameters — even within tolerance — produce different opening sizes for the same mesh count. Always specify both mesh count and wire diameter together to avoid ambiguity when ordering." },
      },
    ],
  },
];
---
<Base title="Mesh to Micron Conversion — Free Tool & ASTM E11 Table | MeshCalculator" description="Convert wire mesh count to micron, millimeter and inch. Free calculator plus ASTM E11 standard sieve conversion table." extraJsonLd={extraJsonLd}>
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-theme-primary">Mesh ↔ Micron Conversion</h1>
    <p class="mt-2 text-theme-secondary">"Mesh" means openings per linear inch. Filter and filtration specs are usually given in microns — convert between them here.</p>

    <div class="mt-8 bg-theme-card border border-theme rounded-xl p-6 grid md:grid-cols-2 gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold mb-1 text-theme-primary" for="mesh">Mesh count (per inch)</label>
          <input id="mesh" type="number" step="1" min="1" value="100" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary" />
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1 text-theme-primary" for="dia">Wire diameter (mm, optional)</label>
          <input id="dia" type="number" step="0.001" value="0.10" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary" />
          <p class="text-xs text-theme-muted mt-1">Used for exact opening. Leave as-is for the standard sieve approximation.</p>
        </div>
      </div>
      <div class="bg-theme-tertiary rounded-lg p-6 flex flex-col justify-center border border-theme">
        <p class="text-lg text-theme-secondary">Opening: <span id="outMm" class="font-bold text-theme-primary">—</span></p>
        <p class="mt-2 text-lg text-theme-secondary">= <span id="outUm" class="font-bold text-theme-primary">—</span></p>
        <p class="mt-2 text-lg text-theme-secondary">= <span id="outIn" class="font-bold text-theme-primary">—</span></p>
        
        <div class="mt-6 flex flex-wrap gap-2">
          <button id="copyBtn" class="accent-bg text-sm font-semibold px-4 py-2 rounded-lg hover:opacity-90 transition-opacity on-accent">Copy Result</button>
          <button id="shareBtn" class="border border-theme text-sm font-semibold px-4 py-2 rounded-lg hover:border-theme-muted transition-colors text-theme-primary">Share Link</button>
        </div>
      </div>
    </div>

    <div class="mt-10 prose max-w-none">
      <h2 class="text-xl font-bold text-theme-primary">ASTM E11 Standard Sieve Series (nominal)</h2>
      <div class="overflow-x-auto mt-4">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr>
              <th class="text-left px-3 py-2 border border-theme bg-theme-tertiary text-theme-primary font-semibold">Mesh</th>
              <th class="text-left px-3 py-2 border border-theme bg-theme-tertiary text-theme-primary font-semibold">Nominal opening (µm)</th>
              <th class="text-left px-3 py-2 border border-theme bg-theme-tertiary text-theme-primary font-semibold">≈ mm</th>
            </tr>
          </thead>
          <tbody>
            {sieveTable.map(([m, um]) => (
              <tr class="border-b border-theme">
                <td class="px-3 py-2 border border-theme text-theme-primary">{m}</td>
                <td class="px-3 py-2 border border-theme text-theme-secondary">{um}</td>
                <td class="px-3 py-2 border border-theme text-theme-secondary">{(um / 1000).toFixed(um >= 1000 ? 2 : 3)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-sm text-theme-muted mt-4">Nominal values from ASTM E11 / ISO 565. Actual opening depends on wire diameter: opening = 25.4/mesh − wire dia (mm).</p>
    </div>
  </section>

  <script>
    const mesh = document.getElementById("mesh") as HTMLInputElement;
    const dia = document.getElementById("dia") as HTMLInputElement;
    function calc() {
      const n = parseFloat(mesh.value), d = parseFloat(dia.value) || 0;
      const outMm = 25.4 / n - d;
      if (!n || outMm <= 0) {
        document.getElementById("outMm")!.textContent = "n/a";
        document.getElementById("outUm")!.textContent = "n/a";
        document.getElementById("outIn")!.textContent = "n/a";
        return;
      }
      document.getElementById("outMm")!.textContent = outMm.toFixed(3) + " mm";
      document.getElementById("outUm")!.textContent = Math.round(outMm * 1000) + " µm (micron)";
      document.getElementById("outIn")!.textContent = (outMm / 25.4).toFixed(4) + " inch";
    }
    mesh.addEventListener("input", calc);
    dia.addEventListener("input", calc);
    
    function copyResult() {
      const text = `Mesh Conversion Result
Mesh: ${mesh.value} per inch
Wire Diameter: ${dia.value} mm

Opening: ${document.getElementById("outMm")!.textContent}
= ${document.getElementById("outUm")!.textContent}
= ${document.getElementById("outIn")!.textContent}

Calculated with MeshCalculator`;
      
      navigator.clipboard.writeText(text).then(() => {
        const btn = document.getElementById("copyBtn")!;
        const original = btn.textContent;
        btn.textContent = "Copied!";
        setTimeout(() => { btn.textContent = original; }, 2000);
      });
    }

    function shareLink() {
      const params = new URLSearchParams({
        mesh: mesh.value,
        dia: dia.value
      });
      const url = window.location.origin + window.location.pathname + "?" + params.toString();
      navigator.clipboard.writeText(url).then(() => {
        const btn = document.getElementById("shareBtn")!;
        const original = btn.textContent;
        btn.textContent = "Link Copied!";
        setTimeout(() => { btn.textContent = original; }, 2000);
      });
    }

    document.getElementById("copyBtn")!.addEventListener("click", copyResult);
    document.getElementById("shareBtn")!.addEventListener("click", shareLink);

    // Load from URL params
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get("mesh")) mesh.value = urlParams.get("mesh")!;
    if (urlParams.get("dia")) dia.value = urlParams.get("dia")!;

    calc();
  </script>
  <section class="max-w-6xl mx-auto px-4 py-8">
    <h2 class="text-xl font-bold text-theme-primary mb-4">Related Guides</h2>
    <div class="grid md:grid-cols-3 gap-4">
        <a href="/blog/wire-mesh-size-chart-explained/" class="bg-theme-card border border-theme rounded-lg p-4 hover:border-theme-primary transition block">
          <div class="font-semibold text-theme-primary">Mesh Size Chart Explained</div>
          <div class="text-sm text-theme-secondary">Mesh, micron & gauge in one table</div>
        </a>
    </div>
  </section>
</Base>
