---
import Base from "../layouts/Base.astro";
import factoriesJson from "../data/factories.json";
import { CATEGORIES } from "../data/categories";

interface Factory {
  slug: string;
  name: string;
  nameZh?: string;
  tier: "listed" | "verified";
  categories: string[];
  city: string;
  province: string;
  website?: string;
  description: string;
  descriptionZh?: string;
}

const factories = factoriesJson as unknown as Factory[];

const labelFor = (key: string) => CATEGORIES.find((c) => c.key === key)?.en ?? key;

// Only offer filters for categories that actually have factories
const presentCategories = CATEGORIES.filter((c) =>
  factories.some((f) => f.categories.includes(c.key))
);

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: factories.map((f, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: f.name,
    url: `https://meshcalculator.com/factories/${f.slug}/`,
  })),
};
---
<Base title="Anping Wire Mesh Factories — Directory" description="Browse real wire mesh factories in Anping, Hebei. No trading companies, no paid rankings.">
  <section class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="text-2xl font-extrabold text-theme-primary">Anping Wire Mesh Factories</h1>
    <p class="mt-2 text-theme-secondary">Every listing is a manufacturer in Anping County. Listings are free; we never sell ranking positions.</p>

    {factories.length > 0 ? (
      <>
        <div id="factory-filters" class="mt-8 flex flex-wrap gap-2">
          <button data-filter="all" class="border border-theme rounded-lg px-3 py-1 text-sm accent-bg font-semibold" style="color:#07090c;">All ({factories.length})</button>
          {presentCategories.map((c) => (
            <button data-filter={c.key} class="border border-theme rounded-lg px-3 py-1 text-sm text-theme-secondary hover:text-theme-primary transition-colors">{c.en}</button>
          ))}
        </div>

        <div class="mt-6 grid md:grid-cols-2 gap-4">
          {factories.map((f) => (
            <a
              href={`/factories/${f.slug}/`}
              data-factory-card
              data-categories={f.categories.join(",")}
              class="bg-theme-card border border-theme rounded-xl p-5 hover:border-theme-primary transition block"
            >
              <div class="flex items-start justify-between gap-3">
                <h3 class="font-bold text-theme-primary">{f.name}</h3>
                {f.tier === "verified" ? (
                  <span class="shrink-0 text-xs font-semibold px-2 py-0.5 rounded-full accent-bg" style="color:#07090c;">Verified</span>
                ) : (
                  <span class="shrink-0 text-xs px-2 py-0.5 rounded-full border border-theme text-theme-muted">Listed</span>
                )}
              </div>
              {f.nameZh && <p class="text-sm text-theme-muted mt-0.5">{f.nameZh}</p>}
              <p class="text-sm text-theme-secondary mt-2 leading-relaxed">{f.description}</p>
              <div class="flex flex-wrap gap-2 mt-3">
                {f.categories.map((c) => (
                  <span class="text-xs px-2 py-0.5 rounded-full bg-theme-secondary border border-theme text-theme-secondary">{labelFor(c)}</span>
                ))}
              </div>
              <p class="text-sm accent-text mt-3 font-medium">View profile →</p>
            </a>
          ))}
        </div>
      </>
    ) : (
      <div class="mt-10 bg-theme-card border border-theme rounded-xl p-12 text-center">
        <p class="text-theme-muted text-lg">Directory launching soon.</p>
        <p class="mt-2 text-sm text-theme-secondary max-w-md mx-auto">
          We are verifying the first batch of factories (business license + production photo check).
          Factories: <a href="/inquiry/" class="text-theme-accent font-semibold">contact us to list your factory for free</a>.
        </p>
      </div>
    )}

    <div class="mt-10 text-sm text-theme-secondary">
      <h2 class="text-lg font-bold text-theme-primary">Listing policy</h2>
      <ul class="list-disc pl-5 space-y-1 mt-2">
        <li>Free to list, free forever for basic profiles.</li>
        <li>Factories only — no trading companies or resellers.</li>
        <li>No paid ranking. Sorting is by category and verification status only.</li>
        <li>We do not certify products or guarantee transactions.</li>
      </ul>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-8">
    <h2 class="text-xl font-bold text-theme-primary mb-4">Related Guides</h2>
    <div class="grid md:grid-cols-3 gap-4">
        <a href="/blog/how-to-verify-china-wire-mesh-factory/" class="bg-theme-card border border-theme rounded-lg p-4 hover:border-theme-primary transition block">
          <div class="font-semibold text-theme-primary">How to Verify a Factory</div>
          <div class="text-sm text-theme-secondary">7-step audit before ordering</div>
        </a>
        <a href="/blog/hebei-wire-mesh-cluster-guide/" class="bg-theme-card border border-theme rounded-lg p-4 hover:border-theme-primary transition block">
          <div class="font-semibold text-theme-primary">Hebei Cluster Guide</div>
          <div class="text-sm text-theme-secondary">Where each product is made</div>
        </a>
        <a href="/blog/wire-mesh-moq-sampling/" class="bg-theme-card border border-theme rounded-lg p-4 hover:border-theme-primary transition block">
          <div class="font-semibold text-theme-primary">MOQ & Sampling</div>
          <div class="text-sm text-theme-secondary">Test orders that protect you</div>
        </a>
    </div>
  </section>

  {factories.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(itemList)} />}

  {factories.length > 0 && (
    <script is:inline>
      (function () {
        var buttons = document.querySelectorAll("#factory-filters [data-filter]");
        var cards = document.querySelectorAll("[data-factory-card]");
        function apply(filter) {
          buttons.forEach(function (b) {
            var on = b.dataset.filter === filter;
            b.classList.toggle("accent-bg", on);
            b.classList.toggle("font-semibold", on);
            b.classList.toggle("text-theme-secondary", !on);
            b.style.color = on ? "#07090c" : "";
          });
          cards.forEach(function (c) {
            var match = filter === "all" || c.dataset.categories.split(",").indexOf(filter) !== -1;
            c.style.display = match ? "" : "none";
          });
        }
        buttons.forEach(function (b) {
          b.addEventListener("click", function () { apply(b.dataset.filter); });
        });
        var initial = new URLSearchParams(location.search).get("category") || "all";
        if (initial !== "all" && !document.querySelector('#factory-filters [data-filter="' + initial + '"]')) initial = "all";
        apply(initial);
      })();
    </script>
  )}
</Base>
