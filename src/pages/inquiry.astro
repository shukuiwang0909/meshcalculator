---
import Base from "../layouts/Base.astro";

const products = [
  "Stainless steel woven mesh",
  "Welded wire mesh / panels",
  "Chain link fence",
  "Wire mesh fence panels",
  "Gabion baskets",
  "Hexagonal wire mesh",
  "Expanded metal",
  "Perforated metal",
  "Other / multiple products",
];

const input = "w-full border border-theme rounded-lg px-3 py-2 bg-theme-card";
const label = "block text-sm font-semibold mb-1";
---

<Base title="Send a Wire Mesh Inquiry — Get Quotes from Anping Factories" description="One structured inquiry, sent directly to matching Anping wire mesh factories. Free for buyers.">
  <section class="max-w-2xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-extrabold">Send an Inquiry</h1>
    <p class="mt-2 text-theme-secondary">Fill in your spec — we forward it to matching factories in Anping. Factories reply to you directly. Free for buyers.</p>

    <form class="mt-8 bg-theme-card border border-theme rounded-xl p-6 space-y-7" name="inquiry" method="POST" action="https://formspree.io/f/xnpqlpoj">
      <input type="hidden" name="_subject" value="New structured inquiry — meshcalculator.com" />
      <input type="hidden" name="_next" value="https://meshcalculator.com/inquiry/thanks/" />
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

      <!-- ① Product Spec -->
      <fieldset class="space-y-4">
        <legend class="text-sm font-bold text-theme-primary uppercase tracking-wide mb-3">① Product Spec</legend>
        <div>
          <label class={label} for="product">Product type</label>
          <select id="product" name="product" class={input} required>
            <option value="">Select…</option>
            {products.map(p => <option>{p}</option>)}
          </select>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class={label} for="mesh_opening">Mesh count / opening size</label>
            <input id="mesh_opening" name="mesh_opening" type="text" class={input} placeholder="e.g. 100 mesh / 50×50 mm" />
          </div>
          <div>
            <label class={label} for="wire_dia">Wire diameter</label>
            <input id="wire_dia" name="wire_dia" type="text" class={input} placeholder="e.g. 0.10 mm / 2.5 mm" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class={label} for="dimensions">Roll / panel size</label>
            <input id="dimensions" name="dimensions" type="text" class={input} placeholder="e.g. 1.0 m × 30 m rolls" />
          </div>
          <div>
            <label class={label} for="quantity">Quantity <span class="text-theme-muted font-normal">(+ unit)</span></label>
            <input id="quantity" name="quantity" type="text" class={input} placeholder="e.g. 500 m² / 200 panels / 5 MT" />
          </div>
        </div>
        <div>
          <label class={label} for="material">Material / standard <span class="text-theme-muted font-normal">(optional)</span></label>
          <input id="material" name="material" type="text" class={input} placeholder="e.g. SS304 / SS316L / hot-dip galvanized / PVC coated / ASTM E2016" />
        </div>
        <div>
          <label class={label} for="message">Notes / drawing reference <span class="text-theme-muted font-normal">(optional)</span></label>
          <textarea id="message" name="message" rows="3" class={input} placeholder="Application, tolerance requirements, certificates needed, links to drawings…"></textarea>
        </div>
      </fieldset>

      <!-- ② Trade Terms -->
      <fieldset class="space-y-4">
        <legend class="text-sm font-bold text-theme-primary uppercase tracking-wide mb-3">② Trade & Destination</legend>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class={label} for="trade_term">Trade term</label>
            <select id="trade_term" name="trade_term" class={input}>
              <option value="">Select…</option>
              <option>FOB</option>
              <option>CIF</option>
              <option>CFR</option>
              <option>EXW</option>
              <option>DAP / DDP</option>
              <option>Not sure — advise me</option>
            </select>
          </div>
          <div>
            <label class={label} for="destination_port">Destination port / city</label>
            <input id="destination_port" name="destination_port" type="text" class={input} placeholder="e.g. Hamburg, Los Angeles, Jebel Ali" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class={label} for="target_price">Target price <span class="text-theme-muted font-normal">(optional)</span></label>
            <input id="target_price" name="target_price" type="text" class={input} placeholder="e.g. USD 12/m²" />
          </div>
          <div>
            <label class={label} for="timeline">Purchase timeline</label>
            <select id="timeline" name="timeline" class={input}>
              <option value="">Select…</option>
              <option>Immediately</option>
              <option>Within 1 month</option>
              <option>1–3 months</option>
              <option>3+ months / researching</option>
            </select>
          </div>
        </div>
      </fieldset>

      <!-- ③ Contact -->
      <fieldset class="space-y-4">
        <legend class="text-sm font-bold text-theme-primary uppercase tracking-wide mb-3">③ Your Contact</legend>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class={label} for="name">Your name</label>
            <input id="name" name="name" type="text" required class={input} />
          </div>
          <div>
            <label class={label} for="email">Work email</label>
            <input id="email" name="email" type="email" required class={input} placeholder="name@company.com" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class={label} for="company">Company</label>
            <input id="company" name="company" type="text" required class={input} />
          </div>
          <div>
            <label class={label} for="website">Company website <span class="text-theme-muted font-normal">(optional)</span></label>
            <input id="website" name="website" type="url" class={input} placeholder="https://…" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class={label} for="whatsapp">WhatsApp <span class="text-theme-muted font-normal">(optional)</span></label>
            <input id="whatsapp" name="whatsapp" type="tel" class={input} placeholder="+1 …" />
          </div>
          <div>
            <label class={label} for="country">Country</label>
            <input id="country" name="country" type="text" required class={input} />
          </div>
        </div>
      </fieldset>

      <button type="submit" class="w-full accent-bg hover:accent-bg text-white font-semibold py-3 rounded-lg transition-colors">Send to matching factories</button>
      <p class="text-xs text-theme-muted">By submitting you agree to our <a href="/terms/" class="underline">Terms</a> and <a href="/privacy/" class="underline">Privacy Policy</a>. We never sell buyer data.</p>
    </form>
  </section>
</Base>
