---
import "../styles/global.css";
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Free wire mesh calculators, spec charts, and direct access to Anping, China wire mesh factories." } = Astro.props;
const nav = [
  { href: "/", label: "Home" },
  { href: "/tools/woven-wire-mesh-weight-calculator/", label: "Tools" },
  { href: "/charts/mesh-size-chart/", label: "Spec Charts" },
  { href: "/anping-wire-mesh/", label: "Why Anping" },
  { href: "/factories/", label: "Factories" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="google-site-verification" content="IsHBKylVlKb1OLPjvZMnuwgzqfv9Hy1SBeH63s-p-6o" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RSYRN427KH"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-RSYRN427KH');
    </script>
  </head>
  <body class="min-h-screen flex flex-col relative">
    <div class="tech-grid"></div>
    <header class="glass sticky top-0 z-50 border-b border-ink-700/50">
      <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between relative z-10">
        <a href="/" class="font-bold text-lg tracking-tight text-white">
          Mesh<span class="text-amber-400">Calculator</span>
        </a>
        <nav class="hidden md:flex gap-6 text-sm">
          {nav.map((n) => (
            <a href={n.href} class="text-ink-300 hover:text-white transition-colors">{n.label}</a>
          ))}
        </nav>
        <a href="/inquiry/" class="bg-amber-500 hover:bg-amber-600 text-ink-950 text-sm font-semibold px-4 py-2 rounded-lg transition-colors">
          Get a Quote
        </a>
      </div>
    </header>
    <main class="flex-1 relative z-10">
      <slot />
    </main>
    <footer class="bg-ink-950 border-t border-ink-800 text-ink-400 text-sm mt-16 relative z-10">
      <div class="max-w-6xl mx-auto px-4 py-10 grid md:grid-cols-3 gap-8">
        <div>
          <p class="text-white font-semibold mb-2">MeshCalculator</p>
          <p>Free wire mesh tools and direct factory sourcing from Anping, Hebei — the wire mesh capital of China.</p>
        </div>
        <div>
          <p class="text-white font-semibold mb-2">Legal</p>
          <ul class="space-y-1">
            <li><a href="/privacy/" class="hover:text-amber-400 transition-colors">Privacy Policy</a></li>
            <li><a href="/terms/" class="hover:text-amber-400 transition-colors">Terms of Use</a></li>
            <li><a href="/disclaimer/" class="hover:text-amber-400 transition-colors">Disclaimer</a></li>
          </ul>
        </div>
        <div>
          <p class="text-white font-semibold mb-2">Disclaimer</p>
          <p class="text-xs text-ink-500">Calculations are theoretical estimates for reference only. We are not liable for errors. We do not participate in transactions; verify suppliers independently.</p>
        </div>
      </div>
      <div class="border-t border-ink-800 py-4 text-center text-xs text-ink-500">
        © 2026 MeshCalculator. All tools are free.
      </div>
    </footer>
  </body>
</html>
