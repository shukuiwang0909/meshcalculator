---
import "../styles/global.css";
import en from "../i18n/en.json";
import zh from "../i18n/zh.json";

interface Props {
  title: string;
  description?: string;
  lang?: "en" | "zh";
}
const { title, description = "Free wire mesh calculators, spec charts, and direct access to Anping, China wire mesh factories.", lang = "en" } = Astro.props;

const t = lang === "zh" ? zh : en;

// Build language switch URLs that preserve the current page
const currentPath = Astro.url.pathname;
let enUrl: string;
let zhUrl: string;

if (lang === "zh") {
  // On a Chinese page: /zh/xxx/ → /xxx/ (strip /zh prefix)
  enUrl = currentPath.replace(/^\/zh/, "") || "/";
  zhUrl = currentPath;
} else {
  // On an EN page: /xxx/ → /zh/xxx/
  enUrl = currentPath;
  zhUrl = "/zh" + currentPath;
}

const nav = [
  { href: lang === "zh" ? "/zh/" : "/", label: t.nav.home },
  { href: lang === "zh" ? "/zh/tools/woven-wire-mesh-weight-calculator/" : "/tools/woven-wire-mesh-weight-calculator/", label: t.nav.tools },
  { href: lang === "zh" ? "/zh/tools/fob-price-calculator/" : "/tools/fob-price-calculator/", label: lang === "zh" ? "FOB计算器" : "FOB Calc" },
  { href: lang === "zh" ? "/zh/tools/container-loading-calculator/" : "/tools/container-loading-calculator/", label: lang === "zh" ? "装箱计算" : "Container Calc" },
  { href: lang === "zh" ? "/zh/tools/inquiry-template-generator/" : "/tools/inquiry-template-generator/", label: lang === "zh" ? "询盘生成" : "Inquiry Gen" },
  { href: lang === "zh" ? "/zh/charts/mesh-size-chart/" : "/charts/mesh-size-chart/", label: t.nav.charts },
  { href: lang === "zh" ? "/zh/anping-wire-mesh/" : "/anping-wire-mesh/", label: t.nav.whyAnping },
  { href: lang === "zh" ? "/zh/factories/" : "/factories/", label: t.nav.factories },
];
---
<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="google-site-verification" content="IsHBKylVlKb1OLPjvZMnuwgzqfv9Hy1SBeH63s-p-6o" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+SC:wght@400;500;600&display=swap" rel="stylesheet" />
    <!-- Theme initialization -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 'dark';
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RSYRN427KH"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-RSYRN427KH');
    </script>
  </head>
  <body class="min-h-screen flex flex-col relative">
    <div class="tech-grid"></div>
    <header class="glass sticky top-0 z-50 border-b border-theme">
      <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between relative z-10">
        <a href={lang === "zh" ? "/zh/" : "/"} class="font-bold text-lg tracking-tight text-theme-primary">
          Mesh<span class="accent-text">Calculator</span>
        </a>
        <nav class="hidden md:flex gap-6 text-sm">
          {nav.map((n) => (
            <a href={n.href} class="text-theme-secondary hover:text-theme-primary transition-colors">{n.label}</a>
          ))}
        </nav>
        <!-- Mobile hamburger button -->
        <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg border border-theme hover:bg-theme-tertiary transition-colors" aria-label="Open menu">
          <svg class="w-5 h-5 text-theme-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
        <div class="flex items-center gap-2 md:gap-3">
          <!-- Language Switcher -->
          <div class="flex items-center gap-1 text-xs md:text-sm border border-theme rounded-lg px-2 py-1">
            <a href={enUrl} class={lang === "en" ? "accent-text font-semibold" : "text-theme-muted hover:text-theme-primary"}>EN</a>
            <span class="text-theme-muted">|</span>
            <a href={zhUrl} class={lang === "zh" ? "accent-text font-semibold" : "text-theme-muted hover:text-theme-primary"}>中文</a>
          </div>
          <!-- Theme Toggle -->
          <button id="theme-toggle" class="p-2 rounded-lg border border-theme hover:bg-theme-tertiary transition-colors" aria-label="Toggle theme">
            <svg class="w-4 h-4 hidden dark:block text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
            <svg class="w-4 h-4 block dark:hidden text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
            </svg>
          </button>
          <!-- Get Quote - hidden on small mobile, visible from sm -->
          <a href="/inquiry/" class="hidden sm:inline-block accent-bg hover:opacity-90 text-white text-sm font-semibold px-3 md:px-4 py-2 rounded-lg transition-colors" style="color: #07090c;">
            {t.nav.getQuote}
          </a>
        </div>
      </div>
    </header>
    <!-- Mobile menu overlay -->
    <div id="mobile-menu" class="fixed inset-0 z-40 hidden">
      <div id="mobile-menu-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
      <div class="absolute top-14 left-0 right-0 bg-theme-primary border-b border-theme shadow-xl">
        <nav class="max-w-6xl mx-auto px-4 py-4 flex flex-col gap-1">
          {nav.map((n) => (
            <a href={n.href} class="mobile-menu-link py-3 px-4 rounded-lg text-theme-secondary hover:text-theme-primary hover:bg-theme-tertiary transition-colors text-base font-medium">{n.label}</a>
          ))}
          <a href="/inquiry/" class="mobile-menu-link mt-2 py-3 px-4 rounded-lg accent-bg text-center font-semibold" style="color: #07090c;">
            {t.nav.getQuote}
          </a>
        </nav>
      </div>
    </div>
    <main class="flex-1 relative z-10">
      <slot />
    </main>
    <footer class="bg-theme-secondary border-t border-theme text-theme-secondary text-sm mt-16 relative z-10">
      <div class="max-w-6xl mx-auto px-4 py-10 grid md:grid-cols-3 gap-8">
        <div>
          <p class="text-theme-primary font-semibold mb-2">MeshCalculator</p>
          <p>{t.footer.tagline}</p>
        </div>
        <div>
          <p class="text-theme-primary font-semibold mb-2">{t.footer.legal}</p>
          <ul class="space-y-1">
            <li><a href="/privacy/" class="hover:text-theme-primary transition-colors">{t.footer.privacy}</a></li>
            <li><a href="/terms/" class="hover:text-theme-primary transition-colors">{t.footer.terms}</a></li>
            <li><a href="/disclaimer/" class="hover:text-theme-primary transition-colors">{t.footer.disclaimer}</a></li>
          </ul>
        </div>
        <div>
          <p class="text-theme-primary font-semibold mb-2">{t.footer.disclaimer}</p>
          <p class="text-xs text-theme-muted">{t.footer.disclaimerText}</p>
        </div>
      </div>
      <div class="border-t border-theme py-4 text-center text-xs text-theme-muted">
        {t.footer.copyright}
      </div>
    </footer>
    <!-- Theme toggle script -->
    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>
    <!-- Mobile menu script -->
    <script is:inline>
      (function() {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        const backdrop = document.getElementById('mobile-menu-backdrop');
        const links = document.querySelectorAll('.mobile-menu-link');
        function openMenu() {
          menu.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }
        function closeMenu() {
          menu.classList.add('hidden');
          document.body.style.overflow = '';
        }
        btn?.addEventListener('click', () => {
          if (menu.classList.contains('hidden')) {
            openMenu();
          } else {
            closeMenu();
          }
        });
        backdrop?.addEventListener('click', closeMenu);
        links.forEach(l => l.addEventListener('click', closeMenu));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !menu.classList.contains('hidden')) closeMenu();
        });
      })();
    </script>
  </body>
</html>
